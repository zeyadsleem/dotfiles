# .local/bin is tracked via .local/bin/.gitignore whitelist

# Tooling session artifacts
.playwright-mcp/
lazyvim-guide.html

# Session logs and scratch
session-ses_*.md
nix-ar/

# Python bytecode from the test suite
__pycache__/
*.pyc

# Runtime-generated artifacts
.config/Thunar/accels.scm
.config/nvim/lua/current_theme.lua
.config/noctalia/palettes/
.config/kitty/themes/

# niri capture scratch files
.config/niri/config.kdl.t3-capture-backup-*

# Yazi writes its own generated theme
.config/yazi/theme.toml
