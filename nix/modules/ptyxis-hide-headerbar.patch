diff --git a/src/ptyxis-window.c b/src/ptyxis-window.c
index ac565dd..3418fda 100644
--- a/src/ptyxis-window.c
+++ b/src/ptyxis-window.c
@@ -395,7 +395,8 @@ update_visible_and_maybe_close (PtyxisWindow *self)
     }
 
   was_visible = gtk_widget_get_visible (GTK_WIDGET (self->tab_bar));
-  visible = !self->single_terminal_mode && n_pages > 1;
+  /* Kitty's tab_bar_style is hidden; herdr owns session management. */
+  visible = FALSE;
 
   if (visible != was_visible)
     {
@@ -2183,6 +2184,10 @@ ptyxis_window_init (PtyxisWindow *self)
 
   gtk_widget_init_template (GTK_WIDGET (self));
 
+  /* Kitty runs with hidden window decorations; match that by removing the
+   * libadwaita header bar entirely. Window management stays in niri. */
+  gtk_widget_set_visible (GTK_WIDGET (self->header_bar), FALSE);
+
   default_icon = g_themed_icon_new ("utilities-terminal-symbolic");
   adw_tab_view_set_default_icon (self->tab_view, default_icon);
 
