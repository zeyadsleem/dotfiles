def main():
    # تجهيز القائمة لـ Noctalia dmenu
    input_str = "\n".join(DATA)

    try:
        # Noctalia launcher مع البحث ودعم اللغة العربية
        import os
        env = os.environ.copy()
        env["LANG"] = "ar_EG.UTF-8"
        env["LC_ALL"] = "ar_EG.UTF-8"

        proc = subprocess.Popen(
            ['noctalia', 'dmenu', '--prompt', '🔎 بحث'],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env
        )
        stdout, stderr = proc.communicate(input=input_str)
        
        if stdout:
            # استخراج الايموجي (أول حرف/رمز في السطر المختار)
            selected_emoji = stdout.strip().split(' ')[0]
            
            # نسخ للـ clipboard
            subprocess.run(['wl-copy', selected_emoji], check=True)
            
    except Exception as e:
        subprocess.run(['notify-send', 'خطأ ❌', str(e)])

if __name__ == "__main__":
    main()
