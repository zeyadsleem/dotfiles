#!/usr/bin/env python3
"""dot — inventory and health check for this machine. Read-only by design."""

from __future__ import annotations

import argparse
import dataclasses
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

TOOL_VERSION = "1"

OWNER_KINDS = (
    "home-manager", "home-manager-stale", "frozen-store", "dotfiles",
    "local:user", "local:tool", "runtime", "broken",
)

EXCLUDED_CONFIG_DIRS = (
    "crush", "goose", "opencode", "Codex", "BraveSoftware",
    "Local", "chromium", "Antigravity",
)

SINGLETON_PREFIX = "Singleton"

SPAWN_KEYWORDS = ("spawn", "spawn-sh", "spawn-at-startup", "spawn-sh-at-startup")

SHELL_SEPARATORS = ("||", "&&", "|", ";")

SHELL_BUILTINS = frozenset({
    "cd", "exec", "export", "source", ".", "test", "[", "echo", "printf",
    "command", "builtin", "eval", "set", "unset", "read", "return", "true", "false",
})

SPAWN_RE = re.compile(
    r"\b(" + "|".join(sorted(SPAWN_KEYWORDS, key=len, reverse=True)) + r")\b"
)

QUOTED_RE = re.compile(r'"([^"]*)"')

KEYBIND_RE = re.compile(r"^[A-Za-z0-9_+.\-]+")

STORE_MARKER = "/nix/store/"
HM_MARKER = "-home-manager-files"
SOURCE_MARKER = "-source"


@dataclasses.dataclass(frozen=True)
class Owner:
    kind: str
    target: str
    reason: str


@dataclasses.dataclass(frozen=True)
class Entry:
    path: str
    owner: Owner


def is_excluded(name: str) -> bool:
    return name in EXCLUDED_CONFIG_DIRS or name.startswith(SINGLETON_PREFIX)


def _resolve(path: str) -> tuple[str, bool]:
    """Return (final_target, exists). Uses os.path.realpath, which is cycle-safe."""
    real = os.path.realpath(path)
    return real, os.path.exists(path)


def _first_hop(path: str) -> str:
    """The immediate link target of `path`, absolute and normalized."""
    target = os.readlink(path)
    if not os.path.isabs(target):
        target = os.path.join(os.path.dirname(path), target)
    return os.path.normpath(target)


def _store_dir(path: str) -> str:
    """The nix store directory name inside a store path."""
    return path.split(STORE_MARKER, 1)[1].split("/", 1)[0]


def _is_under(path: str, root: str) -> bool:
    """True when `path` is `root` or lives inside it (both sides resolved)."""
    if not root:
        return False
    root = os.path.realpath(root)
    if path == root:
        return True
    return path.startswith(root.rstrip("/") + "/")


def classify(
    path: str,
    *,
    current_generation: str | None,
    repo_dir: str,
    home: str | None = None,
) -> Owner:
    if not os.path.islink(path):
        return Owner("runtime", path, "local file")

    target, exists = _resolve(path)
    if not exists:
        return Owner("broken", target, "target missing")

    # A link that lands on a baked `-source` copy reads frozen content, not the repo.
    if STORE_MARKER in target and SOURCE_MARKER in target:
        return Owner("frozen-store", target, "frozen store copy")

    # Home Manager links hop through a `home-manager-files` store directory; the
    # link itself may resolve straight into the repo, so look at the first hop.
    hop = ""
    try:
        hop = _first_hop(path)
    except OSError:
        hop = ""
    if STORE_MARKER in hop and HM_MARKER in hop:
        hm_source = hop
    elif STORE_MARKER in target and HM_MARKER in target:
        hm_source = target
    else:
        hm_source = ""
    if hm_source:
        if current_generation is not None and current_generation not in _store_dir(hm_source):
            return Owner("home-manager-stale", target, "older Home Manager generation")
        return Owner("home-manager", target, "Home Manager (live repo)")

    if _is_under(target, repo_dir):
        return Owner("dotfiles", target, "dotfiles repo")

    if _is_under(target, home if home is not None else str(Path.home())):
        return Owner("local:user", target, "user-managed")

    if STORE_MARKER in target:
        return Owner("local:tool", target, "nix store path")

    return Owner("local:tool", target, "external target")


@dataclasses.dataclass(frozen=True)
class SpawnRef:
    token: str
    context: str
    line: int


def _split_shell_segments(text: str) -> list[str]:
    parts = [text]
    for sep in SHELL_SEPARATORS:
        nxt: list[str] = []
        for part in parts:
            nxt.extend(part.split(sep))
        parts = nxt
    return [p.strip() for p in parts if p.strip()]


def _shell_tokens(command: str) -> list[str]:
    """The command word of every shell segment, skipping builtins, flags and assignments."""
    tokens: list[str] = []
    for segment in _split_shell_segments(command):
        for word in segment.split():
            if word in SHELL_BUILTINS or word.startswith("-") or "=" in word:
                continue
            tokens.append(word)
            break
    return tokens


def _is_path_token(token: str) -> bool:
    """True for a quoted path argument a spawn may execute."""
    if "/" not in token or token.startswith("-"):
        return False
    if token.endswith(".sh"):
        return True
    home = str(Path.home())
    if token.startswith(f"{home}/.local/bin/") or token.startswith(f"{home}/.config/niri/scripts/"):
        return True
    return "/.local/bin/" in token or "/niri/scripts/" in token


def _context_for(line: str, keyword: str, header: str) -> str:
    """The keybind that owns this spawn, or `startup` when there is none."""
    index = line.find(keyword)
    prefix = line[:index].strip() if index >= 0 else ""
    match = KEYBIND_RE.match(prefix)
    if match:
        return match.group(0)
    return header or "startup"


def extract_spawns(config_text: str) -> list[SpawnRef]:
    """Every command token the niri config spawns, in file order."""
    refs: list[SpawnRef] = []
    header = ""
    for number, line in enumerate(config_text.splitlines(), start=1):
        match = SPAWN_RE.search(line)
        if match is None:
            stripped = line.strip()
            if stripped == "}":
                header = ""
            elif stripped.endswith("{"):
                candidate = KEYBIND_RE.match(stripped)
                if candidate:
                    header = candidate.group(0)
            continue
        keyword = match.group(1)
        quoted = QUOTED_RE.findall(line)
        if not quoted:
            continue
        context = _context_for(line, keyword, "" if keyword.endswith("-at-startup") else header)
        if keyword.startswith("spawn-sh"):
            for token in _shell_tokens(quoted[0]):
                refs.append(SpawnRef(token, context, number))
            continue
        if quoted[0]:
            refs.append(SpawnRef(quoted[0], context, number))
        for token in quoted[1:]:
            if _is_path_token(token):
                refs.append(SpawnRef(token, context, number))
    return refs


def _expand_home(token: str) -> str:
    """Expand a leading `~` or `$HOME` to the user's home directory."""
    if token.startswith("$HOME"):
        return str(Path.home()) + token[len("$HOME"):]
    return os.path.expanduser(token)


def resolve_token(token: str, *, path_env: str | None = None) -> str | None:
    """The absolute path of a spawn token, or None when it cannot be found."""
    expanded = _expand_home(token)
    if "/" in expanded:
        return expanded if os.path.exists(expanded) else None
    return shutil.which(expanded, path=path_env)


@dataclasses.dataclass(frozen=True)
class Finding:
    id: str
    severity: str
    path: str
    detail: str
    fix: str
    command: str


SEVERITIES = ("broken", "stale", "missing", "drift", "orphan", "info")

DEFAULT_EXCLUDE_FILE = str(Path.home() / ".config" / "dot" / "exclude")


def _read_exclusions(exclude_file: str | None) -> tuple[set[str], list[str]]:
    """Directory basenames and absolute path prefixes the user wants skipped."""
    path = exclude_file if exclude_file is not None else DEFAULT_EXCLUDE_FILE
    names: set[str] = set()
    prefixes: list[str] = []
    try:
        with open(path, encoding="utf-8") as handle:
            raw_lines = handle.readlines()
    except OSError:
        return names, prefixes
    for raw in raw_lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("/"):
            prefixes.append(line.rstrip("/"))
        else:
            names.add(line)
    return names, prefixes


def _is_skipped(path: str, name: str, names: set[str], prefixes: list[str]) -> bool:
    if is_excluded(name) or name in names:
        return True
    for prefix in prefixes:
        if path == prefix or path.startswith(prefix + "/"):
            return True
    return False


def _scan_dir(
    directory: str,
    *,
    current_generation: str | None,
    repo_dir: str,
    names: set[str],
    prefixes: list[str],
    depth: int,
) -> list[Entry]:
    try:
        children = sorted(os.scandir(directory), key=lambda child: child.name)
    except OSError:
        return []
    found: list[Entry] = []
    for child in children:
        path = child.path
        if _is_skipped(path, child.name, names, prefixes):
            continue
        try:
            is_link = child.is_symlink()
            is_dir = child.is_dir(follow_symlinks=False)
            owner = classify(path, current_generation=current_generation, repo_dir=repo_dir)
        except OSError:
            continue
        found.append(Entry(path, owner))
        if depth == 1 and not is_link and is_dir:
            found.extend(_scan_dir(
                path,
                current_generation=current_generation,
                repo_dir=repo_dir,
                names=names,
                prefixes=prefixes,
                depth=2,
            ))
    return found


def scan_configs(
    roots: list[str],
    *,
    current_generation: str | None,
    repo_dir: str,
    exclude_file: str | None = None,
) -> list[Entry]:
    """Every config entry at depth 1, plus the links inside each config dir."""
    names, prefixes = _read_exclusions(exclude_file)
    entries: list[Entry] = []
    for root in roots:
        entries.extend(_scan_dir(
            root,
            current_generation=current_generation,
            repo_dir=repo_dir,
            names=names,
            prefixes=prefixes,
            depth=1,
        ))
    return entries


def findings_from_entries(entries: list[Entry]) -> list[Finding]:
    """Turn ownership entries into findings, ordered by severity."""
    findings: list[Finding] = []
    for entry in entries:
        kind = entry.owner.kind
        if kind == "broken":
            findings.append(Finding(
                id="broken-symlink",
                severity="broken",
                path=entry.path,
                detail=f"the link target does not exist: {entry.owner.target}",
                fix=f"rm {entry.path}",
                command=f"rm {entry.path}",
            ))
        elif kind == "home-manager-stale":
            findings.append(Finding(
                id="stale-home-manager",
                severity="stale",
                path=entry.path,
                detail=f"the link points at an older Home Manager generation: {entry.owner.target}",
                fix="re-point the link at the current generation",
                command="",
            ))
        elif kind == "frozen-store":
            findings.append(Finding(
                id="frozen-store-copy",
                severity="stale",
                path=entry.path,
                detail="the app reads a frozen store copy, not your repo — edits do not apply",
                fix="re-point the link at the repo path",
                command="",
            ))
    order = {severity: index for index, severity in enumerate(SEVERITIES)}
    findings.sort(key=lambda finding: order[finding.severity])
    return findings


def main(argv: list[str] | None = None) -> int:
    raise NotImplementedError("subcommands land in later tasks")


if __name__ == "__main__":
    sys.exit(main())
