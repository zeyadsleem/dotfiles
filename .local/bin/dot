#!/usr/bin/env python3
"""dot — inventory and health check for this machine. Read-only by design."""

from __future__ import annotations

import argparse
import dataclasses
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

TOOL_VERSION = "1"

OWNER_KINDS = (
    "home-manager", "home-manager-stale", "frozen-store", "dotfiles",
    "local:user", "local:tool", "runtime", "broken",
)

EXCLUDED_CONFIG_DIRS = (
    "crush", "goose", "opencode", "Codex", "BraveSoftware",
    "Local", "chromium", "Antigravity",
)

SINGLETON_PREFIX = "Singleton"

SPAWN_KEYWORDS = ("spawn", "spawn-sh", "spawn-at-startup", "spawn-sh-at-startup")

SHELL_SEPARATORS = ("||", "&&", "|", ";")

SHELL_BUILTINS = frozenset({
    "cd", "exec", "export", "source", ".", "test", "[", "echo", "printf",
    "command", "builtin", "eval", "set", "unset", "read", "return", "true", "false",
})

SPAWN_RE = re.compile(
    r"\b(" + "|".join(sorted(SPAWN_KEYWORDS, key=len, reverse=True)) + r")\b"
)

QUOTED_RE = re.compile(r'"([^"]*)"')

KEYBIND_RE = re.compile(r"^[A-Za-z0-9_+.\-]+")

STORE_MARKER = "/nix/store/"
HM_MARKER = "-home-manager-files"
SOURCE_MARKER = "-source"


@dataclasses.dataclass(frozen=True)
class Owner:
    kind: str
    target: str
    reason: str


@dataclasses.dataclass(frozen=True)
class Entry:
    path: str
    owner: Owner


def is_excluded(name: str) -> bool:
    return name in EXCLUDED_CONFIG_DIRS or name.startswith(SINGLETON_PREFIX)


def _resolve(path: str) -> tuple[str, bool]:
    """Return (final_target, exists). Uses os.path.realpath, which is cycle-safe."""
    real = os.path.realpath(path)
    return real, os.path.exists(path)


def _first_hop(path: str) -> str:
    """The immediate link target of `path`, absolute and normalized."""
    target = os.readlink(path)
    if not os.path.isabs(target):
        target = os.path.join(os.path.dirname(path), target)
    return os.path.normpath(target)


def _store_dir(path: str) -> str:
    """The nix store directory name inside a store path."""
    return path.split(STORE_MARKER, 1)[1].split("/", 1)[0]


def _is_under(path: str, root: str) -> bool:
    """True when `path` is `root` or lives inside it (both sides resolved)."""
    if not root:
        return False
    root = os.path.realpath(root)
    if path == root:
        return True
    return path.startswith(root.rstrip("/") + "/")


def classify(
    path: str,
    *,
    current_generation: str | None,
    repo_dir: str,
    home: str | None = None,
) -> Owner:
    if not os.path.islink(path):
        return Owner("runtime", path, "local file")

    target, exists = _resolve(path)
    if not exists:
        return Owner("broken", target, "target missing")

    # A link that lands on a baked `-source` copy reads frozen content, not the repo.
    if STORE_MARKER in target and SOURCE_MARKER in target:
        return Owner("frozen-store", target, "frozen store copy")

    # Home Manager links hop through a `home-manager-files` store directory; the
    # link itself may resolve straight into the repo, so look at the first hop.
    hop = ""
    try:
        hop = _first_hop(path)
    except OSError:
        hop = ""
    if STORE_MARKER in hop and HM_MARKER in hop:
        hm_source = hop
    elif STORE_MARKER in target and HM_MARKER in target:
        hm_source = target
    else:
        hm_source = ""
    if hm_source:
        if current_generation is not None and current_generation not in _store_dir(hm_source):
            return Owner("home-manager-stale", target, "older Home Manager generation")
        return Owner("home-manager", target, "Home Manager (live repo)")

    if _is_under(target, repo_dir):
        return Owner("dotfiles", target, "dotfiles repo")

    if _is_under(target, home if home is not None else str(Path.home())):
        return Owner("local:user", target, "user-managed")

    if STORE_MARKER in target:
        return Owner("local:tool", target, "nix store path")

    return Owner("local:tool", target, "external target")


@dataclasses.dataclass(frozen=True)
class SpawnRef:
    token: str
    context: str
    line: int


def _split_shell_segments(text: str) -> list[str]:
    parts = [text]
    for sep in SHELL_SEPARATORS:
        nxt: list[str] = []
        for part in parts:
            nxt.extend(part.split(sep))
        parts = nxt
    return [p.strip() for p in parts if p.strip()]


def _shell_tokens(command: str) -> list[str]:
    """The command word of every shell segment, skipping builtins, flags and assignments."""
    tokens: list[str] = []
    for segment in _split_shell_segments(command):
        for word in segment.split():
            if word in SHELL_BUILTINS or word.startswith("-") or "=" in word:
                continue
            tokens.append(word)
            break
    return tokens


def _is_path_token(token: str) -> bool:
    """True for a quoted path argument a spawn may execute."""
    if "/" not in token or token.startswith("-"):
        return False
    if token.endswith(".sh"):
        return True
    home = str(Path.home())
    if token.startswith(f"{home}/.local/bin/") or token.startswith(f"{home}/.config/niri/scripts/"):
        return True
    return "/.local/bin/" in token or "/niri/scripts/" in token


def _context_for(line: str, keyword: str, header: str) -> str:
    """The keybind that owns this spawn, or `startup` when there is none."""
    index = line.find(keyword)
    prefix = line[:index].strip() if index >= 0 else ""
    match = KEYBIND_RE.match(prefix)
    if match:
        return match.group(0)
    return header or "startup"


def extract_spawns(config_text: str) -> list[SpawnRef]:
    """Every command token the niri config spawns, in file order."""
    refs: list[SpawnRef] = []
    header = ""
    for number, line in enumerate(config_text.splitlines(), start=1):
        match = SPAWN_RE.search(line)
        if match is None:
            stripped = line.strip()
            if stripped == "}":
                header = ""
            elif stripped.endswith("{"):
                candidate = KEYBIND_RE.match(stripped)
                if candidate:
                    header = candidate.group(0)
            continue
        keyword = match.group(1)
        quoted = QUOTED_RE.findall(line)
        if not quoted:
            continue
        context = _context_for(line, keyword, "" if keyword.endswith("-at-startup") else header)
        if keyword.startswith("spawn-sh"):
            for token in _shell_tokens(quoted[0]):
                refs.append(SpawnRef(token, context, number))
            continue
        if quoted[0]:
            refs.append(SpawnRef(quoted[0], context, number))
        for token in quoted[1:]:
            if _is_path_token(token):
                refs.append(SpawnRef(token, context, number))
    return refs


def _expand_home(token: str) -> str:
    """Expand a leading `~` or `$HOME` to the user's home directory."""
    if token.startswith("$HOME"):
        return str(Path.home()) + token[len("$HOME"):]
    return os.path.expanduser(token)


def resolve_token(token: str, *, path_env: str | None = None) -> str | None:
    """The absolute path of a spawn token, or None when it cannot be found."""
    expanded = _expand_home(token)
    if "/" in expanded:
        return expanded if os.path.exists(expanded) else None
    return shutil.which(expanded, path=path_env)


@dataclasses.dataclass(frozen=True)
class Finding:
    id: str
    severity: str
    path: str
    detail: str
    fix: str
    command: str


SEVERITIES = ("broken", "stale", "missing", "drift", "orphan", "info")

DEFAULT_EXCLUDE_FILE = str(Path.home() / ".config" / "dot" / "exclude")


def _read_exclusions(exclude_file: str | None) -> tuple[set[str], list[str]]:
    """Directory basenames and absolute path prefixes the user wants skipped."""
    path = exclude_file if exclude_file is not None else DEFAULT_EXCLUDE_FILE
    names: set[str] = set()
    prefixes: list[str] = []
    try:
        with open(path, encoding="utf-8") as handle:
            raw_lines = handle.readlines()
    except OSError:
        return names, prefixes
    for raw in raw_lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("/"):
            prefixes.append(line.rstrip("/"))
        else:
            names.add(line)
    return names, prefixes


def _is_skipped(path: str, name: str, names: set[str], prefixes: list[str]) -> bool:
    if is_excluded(name) or name in names:
        return True
    for prefix in prefixes:
        if path == prefix or path.startswith(prefix + "/"):
            return True
    return False


def _scan_dir(
    directory: str,
    *,
    current_generation: str | None,
    repo_dir: str,
    names: set[str],
    prefixes: list[str],
    depth: int,
) -> list[Entry]:
    try:
        children = sorted(os.scandir(directory), key=lambda child: child.name)
    except OSError:
        return []
    found: list[Entry] = []
    for child in children:
        path = child.path
        if _is_skipped(path, child.name, names, prefixes):
            continue
        try:
            is_link = child.is_symlink()
            is_dir = child.is_dir(follow_symlinks=False)
            owner = classify(path, current_generation=current_generation, repo_dir=repo_dir)
        except OSError:
            continue
        found.append(Entry(path, owner))
        if depth == 1 and not is_link and is_dir:
            found.extend(_scan_dir(
                path,
                current_generation=current_generation,
                repo_dir=repo_dir,
                names=names,
                prefixes=prefixes,
                depth=2,
            ))
    return found


def scan_configs(
    roots: list[str],
    *,
    current_generation: str | None,
    repo_dir: str,
    exclude_file: str | None = None,
) -> list[Entry]:
    """Every config entry at depth 1, plus the links inside each config dir."""
    names, prefixes = _read_exclusions(exclude_file)
    entries: list[Entry] = []
    for root in roots:
        entries.extend(_scan_dir(
            root,
            current_generation=current_generation,
            repo_dir=repo_dir,
            names=names,
            prefixes=prefixes,
            depth=1,
        ))
    return entries


def findings_from_entries(entries: list[Entry]) -> list[Finding]:
    """Turn ownership entries into findings, ordered by severity."""
    findings: list[Finding] = []
    for entry in entries:
        kind = entry.owner.kind
        if kind == "broken":
            findings.append(Finding(
                id="broken-symlink",
                severity="broken",
                path=entry.path,
                detail=f"the link target does not exist: {entry.owner.target}",
                fix=f"rm {entry.path}",
                command=f"rm {entry.path}",
            ))
        elif kind == "home-manager-stale":
            findings.append(Finding(
                id="stale-home-manager",
                severity="stale",
                path=entry.path,
                detail=f"the link points at an older Home Manager generation: {entry.owner.target}",
                fix="re-point the link at the current generation",
                command="",
            ))
        elif kind == "frozen-store":
            findings.append(Finding(
                id="frozen-store-copy",
                severity="stale",
                path=entry.path,
                detail="the app reads a frozen store copy, not your repo — edits do not apply",
                fix="re-point the link at the repo path",
                command="",
            ))
    order = {severity: index for index, severity in enumerate(SEVERITIES)}
    findings.sort(key=lambda finding: order[finding.severity])
    return findings


@dataclasses.dataclass(frozen=True)
class Source:
    """One place software comes from: pacman, the nix profile, desktop files, scripts."""

    name: str
    items: list[str]
    kind: str


TOOL_DIRS: tuple[tuple[str, str], ...] = (
    ("mise", ".local/share/mise/shims"),
    ("uv", ".local/share/uv/tools"),
    ("go", "go/bin"),
    ("vite-plus", ".vite-plus/bin"),
    ("opencode", ".opencode/bin"),
)

PROFILE_BIN_REL = ".local/state/nix/profiles/profile/bin"


def _run(cmd: list[str], runner=None) -> str:
    """The stdout of a command, or an empty string when it is missing or fails."""
    run = runner or subprocess.run
    try:
        proc = run(cmd, capture_output=True, text=True, check=False)
    except (FileNotFoundError, OSError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout


def _split_lines(text: str) -> list[str]:
    return [line.strip() for line in text.splitlines() if line.strip()]


def _dir_names(directory: str) -> list[str] | None:
    """The sorted entries of a directory, or None when it cannot be read."""
    try:
        names = os.listdir(directory)
    except OSError:
        return None
    return sorted(names)


def default_repo_dir() -> str:
    """The dotfiles repository that ships this script, found by walking up to `.git`."""
    directory = os.path.dirname(os.path.realpath(__file__))
    while True:
        if os.path.exists(os.path.join(directory, ".git")):
            return directory
        parent = os.path.dirname(directory)
        if parent == directory:
            return ""
        directory = parent


def collect_pacman(runner=None) -> dict[str, list[str]]:
    """Installed system packages, foreign (AUR) packages and orphans."""
    return {
        "system": _split_lines(_run(["pacman", "-Qq"], runner)),
        "foreign": _split_lines(_run(["pacman", "-Qmq"], runner)),
        "orphans": _split_lines(_run(["pacman", "-Qdtq"], runner)),
    }


def collect_profile_bins(profile_dir: str | None = None) -> list[str]:
    """The binaries the nix profile puts on PATH, without the hidden wrappers."""
    directory = profile_dir or str(Path.home() / PROFILE_BIN_REL)
    names = _dir_names(directory)
    if names is None:
        return []
    return [name for name in names if not name.startswith(".")]


def collect_desktop_entries(dirs: list[str], *, home: str | None = None) -> list[dict]:
    """The installed applications, read from their `.desktop` files."""
    base = home if home is not None else str(Path.home())
    entries: list[dict] = []
    for directory in dirs:
        names = _dir_names(directory)
        if names is None:
            continue
        for name in names:
            if not name.endswith(".desktop"):
                continue
            path = os.path.join(directory, name)
            try:
                with open(path, encoding="utf-8", errors="replace") as handle:
                    content = handle.read()
            except OSError:
                continue
            label = ""
            for line in content.splitlines():
                if line.startswith("Name="):
                    label = line[len("Name="):].strip()
                    break
            if not label:
                continue
            entries.append({
                "name": label,
                "desktop_file": path,
                "source": "user" if _is_under(os.path.realpath(path), base) else "system",
            })
    return entries


def _git_tracked(path: str, repo_dir: str) -> bool:
    """True when git tracks `path` inside `repo_dir`."""
    repo = os.path.realpath(repo_dir)
    try:
        relative = os.path.relpath(path, repo)
    except ValueError:
        return False
    if relative.startswith(".."):
        return False
    output = _run(["git", "-C", repo, "ls-files", "--error-unmatch", "--", relative])
    return bool(output.strip())


def collect_scripts(bin_dir: str, repo_dir: str | None = None) -> dict[str, list[str]]:
    """The scripts in `bin_dir`, split into repo-owned and locally installed."""
    names = _dir_names(bin_dir)
    if names is None:
        return {"repo": [], "local": []}
    repo: list[str] = []
    local: list[str] = []
    for name in names:
        if name.startswith("."):
            continue
        path = os.path.join(os.path.realpath(bin_dir), name)
        if repo_dir and _git_tracked(path, repo_dir):
            repo.append(name)
        else:
            local.append(name)
    return {"repo": repo, "local": local}


def collect_outdated(runner=None) -> list[str]:
    """Packages with a newer version available. Reaches the network — opt in only."""
    packages: list[str] = []
    for line in _run(["checkupdates"], runner).splitlines():
        parts = line.split()
        if parts:
            packages.append(parts[0])
    return packages


def collect_repo_state(repo_dir: str | None = None) -> dict[str, list[str]]:
    """The uncommitted changes in the dotfiles repository."""
    directory = repo_dir if repo_dir is not None else default_repo_dir()
    if not directory:
        return {"modified": [], "untracked": []}
    modified: list[str] = []
    untracked: list[str] = []
    for raw in _run(["git", "-C", directory, "status", "--porcelain"]).splitlines():
        if not raw.strip():
            continue
        # Porcelain lines are `XY<space>path`; the status field may start with a
        # space, so the path starts at index 3 and is only left-trimmed.
        path = raw[2:].lstrip()
        if raw.startswith("??"):
            untracked.append(path)
        else:
            modified.append(path)
    return {"modified": modified, "untracked": untracked}


def tool_dir_paths(home: str | None = None) -> list[str]:
    """The absolute paths of the tool directories, for the given home."""
    base = home if home is not None else str(Path.home())
    return [os.path.join(base, relative) for _, relative in TOOL_DIRS]


def _tool_label(path: str) -> str:
    normalized = os.path.normpath(path)
    for label, relative in TOOL_DIRS:
        if normalized.endswith(relative):
            return label
    return os.path.basename(normalized)


def collect_tool_dirs(dirs: list[str]) -> dict[str, list[str]]:
    """The entries of each tool directory that exists, keyed by tool."""
    found: dict[str, list[str]] = {}
    for directory in dirs:
        names = _dir_names(directory)
        if names is None:
            continue
        found[_tool_label(directory)] = names
    return found


DECLARATIONS_FILE = "nix/modules/packages.nix"

DECLARED_NAME_RE = re.compile(r"^\s{4}([a-zA-Z0-9_.-]+)\s*$")

PNAME_RE = re.compile(r'pname\s*=\s*"([^"]+)"')

STORE_NAME_RE = re.compile(r"^[a-z0-9]{32}-(.+)$")

VERSION_RE = re.compile(r"-\d")


def parse_declared_packages(text: str) -> set[str]:
    """The package names declared in `nix/modules/packages.nix`."""
    names: set[str] = set()
    in_derivation = False
    for line in text.splitlines():
        if "mkDerivation" in line:
            in_derivation = True
        if in_derivation:
            # A hand written derivation declares its package through `pname`;
            # the attribute names inside the block are not packages.
            match = PNAME_RE.search(line)
            if match:
                names.add(match.group(1))
            if line.strip().startswith("})"):
                in_derivation = False
            continue
        match = DECLARED_NAME_RE.match(line)
        if match:
            names.add(match.group(1))
    return names


def _store_package_path(target: str) -> str:
    """The store path of the nix package that provides `target`."""
    index = target.find(STORE_MARKER)
    if index < 0:
        return ""
    package, _, _ = target[index + len(STORE_MARKER):].partition("/")
    return STORE_MARKER + package if package else ""


def _strip_version(name: str) -> str:
    """A nixpkgs package name without its version suffix."""
    match = VERSION_RE.search(name)
    return name[:match.start()] if match else name


def _package_name(store_path: str) -> str:
    """The package name of a nix store path."""
    base = os.path.basename(store_path)
    match = STORE_NAME_RE.match(base)
    return _strip_version(match.group(1) if match else base)


def package_binary_map(profile_dir: str | None = None, runner=None) -> dict[str, list[str]]:
    """The profile binaries each nix package provides, keyed by package name."""
    directory = profile_dir or str(Path.home() / PROFILE_BIN_REL)
    packages: dict[str, list[str]] = {}
    for name in collect_profile_bins(directory):
        target = os.path.realpath(os.path.join(directory, name))
        package = _store_package_path(target)
        if package:
            packages.setdefault(package, []).append(name)
    if not packages:
        return {}
    output = _run(["nix", "path-info", "--json", *sorted(packages)], runner)
    if not output.strip():
        return {}
    try:
        data = json.loads(output)
    except ValueError:
        return {}
    if not isinstance(data, dict):
        return {}
    result: dict[str, list[str]] = {}
    for package_path, binaries in packages.items():
        info = data.get(package_path)
        label = ""
        if isinstance(info, dict):
            name = info.get("name")
            if isinstance(name, str) and name:
                label = _strip_version(name)
        if not label:
            label = _package_name(package_path)
        result.setdefault(label, []).extend(binaries)
    return {label: sorted(bins) for label, bins in sorted(result.items())}


def _same_package(declared: str, other: str) -> bool:
    """True when `other` names the same package as `declared`.

    nixpkgs is not consistent about package names: the attribute `antigravity`
    ships the package `antigravity-ide`, `nixfmt-rfc-style` ships `nixfmt`, and
    the python packages carry a `python3.14-` prefix.
    """
    if declared == other:
        return True
    return (
        other.startswith(declared + "-")
        or declared.startswith(other + "-")
        or other.endswith("-" + declared)
        or declared.endswith("-" + other)
    )


def nix_drift(
    declared: set[str],
    installed: set[str],
    package_bins: dict[str, list[str]],
) -> list[Finding]:
    """The drift between the declared packages and the ones the profile provides."""
    findings: list[Finding] = []
    for package in sorted(declared):
        candidates = set(package_bins.get(package) or [package])
        satisfied = any(candidate in installed for candidate in candidates)
        if not satisfied:
            satisfied = any(_same_package(package, binary) for binary in installed)
        if not satisfied:
            findings.append(Finding(
                id="nix-not-installed",
                severity="drift",
                path=DECLARATIONS_FILE,
                detail=f"`{package}` declared in nix/modules/packages.nix but not installed",
                fix="dot pkg sync",
                command="",
            ))

    owner_of: dict[str, str] = {}
    for package, binaries in package_bins.items():
        for binary in binaries:
            owner_of.setdefault(binary, package)

    if package_bins:
        undeclared: dict[str, list[str]] = {}
        unknown_owner: list[str] = []
        for binary in sorted(installed):
            owner = owner_of.get(binary)
            if owner is None:
                if not any(_same_package(name, binary) for name in declared):
                    unknown_owner.append(binary)
                continue
            if any(_same_package(name, owner) for name in declared):
                continue
            undeclared.setdefault(owner, []).append(binary)
        for owner, binaries in sorted(undeclared.items()):
            findings.append(Finding(
                id="nix-undeclared",
                severity="drift",
                path=DECLARATIONS_FILE,
                detail=(
                    f"`{owner}` is installed in the Nix profile but not declared "
                    f"in packages.nix ({', '.join(binaries)})"
                ),
                fix=f"add {owner} to nix/modules/packages.nix",
                command="",
            ))
        for binary in unknown_owner:
            findings.append(Finding(
                id="nix-undeclared",
                severity="drift",
                path=DECLARATIONS_FILE,
                detail=(
                    f"`{binary}` is installed in the Nix profile but not declared "
                    "in packages.nix (owner unknown)"
                ),
                fix=f"add {binary} to nix/modules/packages.nix",
                command="",
            ))
    elif not findings:
        unattributed = [
            binary for binary in sorted(installed)
            if not any(_same_package(name, binary) for name in declared)
        ]
        if unattributed:
            findings.append(Finding(
                id="nix-unattributed",
                severity="drift",
                path=DECLARATIONS_FILE,
                detail=(
                    "installed in the Nix profile but not declared in packages.nix "
                    f"(owner unknown): {', '.join(unattributed)}"
                ),
                fix="add them to nix/modules/packages.nix",
                command="",
            ))
    return findings


COLOR = {
    "broken": "31",         # red
    "stale": "35",          # magenta
    "missing": "38;5;208",  # orange
    "drift": "33",          # yellow
    "ok": "32",             # green
    "muted": "2",           # dim
}

HEADLINE_SEVERITIES = ("broken", "stale", "missing", "drift")

COUNT_KEYS = ("broken", "stale", "missing", "drift", "info")

RUNTIME_OWNER = "runtime"

TOP_CLI_LIMIT = 12


@dataclasses.dataclass(frozen=True)
class Inventory:
    """Everything `dot` knows about this machine."""
    apps: list[dict]
    cli: list[Source]
    scripts: dict[str, list[str]]
    configs: list[Entry]
    findings: list[Finding]
    meta: dict


def _use_color() -> bool:
    """True when the output may carry color: a terminal, and no NO_COLOR."""
    if os.environ.get("NO_COLOR"):
        return False
    try:
        return sys.stdout.isatty()
    except (AttributeError, ValueError):
        return False


def _paint(text: str, key: str) -> str:
    code = COLOR.get(key)
    if not code or not _use_color():
        return text
    return f"\033[{code}m{text}\033[0m"


def _severity_counts(findings: list[Finding]) -> dict[str, int]:
    counts = {key: 0 for key in COUNT_KEYS}
    for finding in findings:
        if finding.severity in counts:
            counts[finding.severity] += 1
    return counts


def _managed_configs(inventory: Inventory) -> list[Entry]:
    """The config entries the user or a tool owns — not the app runtime dirs."""
    return [entry for entry in inventory.configs if entry.owner.kind != RUNTIME_OWNER]


def _breakdown(counts: dict[str, int]) -> str:
    ordered = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
    return " · ".join(f"{name} {count}" for name, count in ordered)


def _count_line(label: str, count: int, breakdown: str = "") -> str:
    line = f"  {label:<16}{count:>6}"
    return f"{line}     {breakdown}" if breakdown else line


def _top_cli(inventory: Inventory) -> list[str]:
    """The curated command line tools: the nix profile, or the tool shims."""
    names: list[str] = []
    for kind in ("cli", "binary"):
        for source in inventory.cli:
            if source.kind == kind:
                names.extend(source.items)
        if names:
            break
    return sorted(names)


def _inventory_counts(inventory: Inventory) -> list[str]:
    app_sources: dict[str, int] = {}
    for app in inventory.apps:
        source = app.get("source", "unknown")
        app_sources[source] = app_sources.get(source, 0) + 1
    packages = {s.name: len(s.items) for s in inventory.cli if s.kind in ("package", "cli")}
    tooling = {s.name: len(s.items) for s in inventory.cli if s.kind == "binary"}
    managed = _managed_configs(inventory)
    owners: dict[str, int] = {}
    for entry in managed:
        owners[entry.owner.kind] = owners.get(entry.owner.kind, 0) + 1
    groups = {group: len(names) for group, names in inventory.scripts.items()}
    return [
        _count_line("Desktop apps", len(inventory.apps), _breakdown(app_sources)),
        _count_line("CLI packages", sum(packages.values()), _breakdown(packages)),
        _count_line("Tooling", sum(tooling.values()), _breakdown(tooling)),
        _count_line("AUR / foreign", int(inventory.meta.get("foreign", 0))),
        _count_line("Orphans", int(inventory.meta.get("orphans", 0)), "safe to remove"),
        _count_line("Managed configs", len(managed), _breakdown(owners)),
        _count_line("Local scripts", sum(groups.values()), _breakdown(groups)),
    ]


def _full_lists(inventory: Inventory) -> list[str]:
    lines = [""]
    lines.append(f"  Desktop apps ({len(inventory.apps)}):")
    for app in inventory.apps:
        lines.append(f"    {app.get('name', '')}")
    for source in inventory.cli:
        lines.append(f"  {source.name} ({len(source.items)}):")
        for item in source.items:
            lines.append(f"    {item}")
    for group, names in inventory.scripts.items():
        lines.append(f"  {group} scripts ({len(names)}):")
        for name in names:
            lines.append(f"    {name}")
    managed = _managed_configs(inventory)
    lines.append(f"  Managed configs ({len(managed)}):")
    for entry in managed:
        lines.append(f"    {entry.path} → {entry.owner.target}  ({entry.owner.kind})")
    return lines


def render_list(inventory: Inventory, *, wide: bool = False, show_all: bool = False) -> str:
    """The `dot list` view: what is installed, grouped by source."""
    distro = inventory.meta.get("distro", "unknown")
    host = inventory.meta.get("host", "unknown")
    lines = [
        f"System inventory · {distro} · {host}",
        "─" * 60,
    ]
    lines.extend(_inventory_counts(inventory))
    top_cli = _top_cli(inventory)
    if top_cli:
        lines.append("")
        lines.append("  Top CLI: " + "  ".join(top_cli if wide else top_cli[:TOP_CLI_LIMIT]))
    if show_all:
        lines.extend(_full_lists(inventory))
    lines.append("")
    lines.append("  Full lists: dot list --all --cli")
    return "\n".join(lines)


def render_status(inventory: Inventory) -> str:
    """The `dot status` view: what is broken, stale, missing or drifted."""
    counts = _severity_counts(inventory.findings)
    total = sum(counts[key] for key in HEADLINE_SEVERITIES)
    lines: list[str] = []
    if total == 0:
        lines.append(_paint("● no findings", "ok"))
    else:
        parts = [f"{counts[key]} {key}" for key in HEADLINE_SEVERITIES if counts[key]]
        worst = next((key for key in HEADLINE_SEVERITIES if counts[key]), "muted")
        lines.append(_paint(f"● {total} findings — {', '.join(parts)}", worst))
    for severity in SEVERITIES:
        group = [finding for finding in inventory.findings if finding.severity == severity]
        if not group:
            continue
        lines.append("")
        lines.append(_paint(f"{severity.upper()} ({len(group)})", severity))
        marker = "✗" if severity in ("broken", "missing") else "~"
        for finding in group:
            lines.append(f"  {marker} {finding.path}")
            if finding.detail:
                lines.append(f"      {finding.detail}")
            if finding.fix:
                lines.append(f"      fix: {finding.fix}")
    return "\n".join(lines)


def _sections(inventory: Inventory) -> dict:
    cli_items = [
        {"source": source.name, "name": item}
        for source in inventory.cli
        for item in source.items
    ]
    script_items = [
        {"group": group, "name": name}
        for group, names in inventory.scripts.items()
        for name in names
    ]
    config_items = [
        {"path": entry.path, "owner": entry.owner.kind, "target": entry.owner.target}
        for entry in _managed_configs(inventory)
    ]
    return {
        "apps": {"count": len(inventory.apps), "items": list(inventory.apps)},
        "cli": {"count": len(cli_items), "items": cli_items},
        "scripts": {"count": len(script_items), "items": script_items},
        "configs": {"count": len(config_items), "items": config_items},
    }


def _summary(inventory: Inventory) -> dict:
    by_owner: dict[str, int] = {}
    for entry in inventory.configs:
        kind = entry.owner.kind
        by_owner[kind] = by_owner.get(kind, 0) + 1
    by_source = {source.name: len(source.items) for source in inventory.cli}
    total = sum(section["count"] for section in _sections(inventory).values())
    return {"total": total, "by_source": by_source, "by_owner": by_owner}


def inventory_json(inventory: Inventory, *, command: str) -> dict:
    """The machine readable view, in the frozen shape of spec §7.6."""
    data = {
        "tool": "dot",
        "version": TOOL_VERSION,
        "command": command,
        "generated_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "summary": _summary(inventory),
        "sections": _sections(inventory),
    }
    if command == "status":
        counts = _severity_counts(inventory.findings)
        data["ok"] = not any(counts[key] for key in HEADLINE_SEVERITIES)
        data["counts"] = counts
        data["findings"] = [
            {
                "id": finding.id,
                "severity": finding.severity,
                "path": finding.path,
                "detail": finding.detail,
                "fix": finding.fix,
                "command": finding.command,
            }
            for finding in inventory.findings
        ]
    return data


def main(argv: list[str] | None = None) -> int:
    raise NotImplementedError("subcommands land in later tasks")


if __name__ == "__main__":
    sys.exit(main())
