#!/usr/bin/env python3
"""dot — inventory and health check for this machine. Read-only by design."""

from __future__ import annotations

import argparse
import dataclasses
import datetime
import difflib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
from pathlib import Path

TOOL_VERSION = "1"

OWNER_KINDS = (
    "home-manager", "home-manager-stale", "frozen-store", "dotfiles",
    "local:user", "local:tool", "runtime", "broken",
)

EXCLUDED_CONFIG_DIRS = (
    "crush", "goose", "opencode", "Codex", "BraveSoftware",
    "Local", "chromium", "Antigravity",
)

SINGLETON_PREFIX = "Singleton"

# The config scan reaches three levels deep, so a broken link inside an app's
# own directory (`~/.config/sway/scripts/x`) is found. Only the first two
# levels are the inventory: the third level only reports breakage.
MAX_SCAN_DEPTH = 3
INVENTORY_DEPTH = 2

SPAWN_KEYWORDS = ("spawn", "spawn-sh", "spawn-at-startup", "spawn-sh-at-startup")

SHELL_SEPARATORS = ("||", "&&", "|", ";")

SHELL_BUILTINS = frozenset({
    "cd", "exec", "export", "source", ".", "test", "[", "echo", "printf",
    "command", "builtin", "eval", "set", "unset", "read", "return", "true", "false",
})

SPAWN_RE = re.compile(
    r"\b(" + "|".join(sorted(SPAWN_KEYWORDS, key=len, reverse=True)) + r")\b"
)

QUOTED_RE = re.compile(r'"([^"]*)"')

KEYBIND_RE = re.compile(r"^[A-Za-z0-9_+.\-]+")

STORE_MARKER = "/nix/store/"
HM_MARKER = "-home-manager-files"
SOURCE_MARKER = "-source"


@dataclasses.dataclass(frozen=True)
class Owner:
    kind: str
    target: str
    reason: str


@dataclasses.dataclass(frozen=True)
class Entry:
    path: str
    owner: Owner
    depth: int = 1


def is_excluded(name: str) -> bool:
    return name in EXCLUDED_CONFIG_DIRS or name.startswith(SINGLETON_PREFIX)


def _resolve(path: str) -> tuple[str, bool]:
    """Return (final_target, exists). Uses os.path.realpath, which is cycle-safe."""
    real = os.path.realpath(path)
    return real, os.path.exists(path)


def _first_hop(path: str) -> str:
    """The immediate link target of `path`, absolute and normalized."""
    target = os.readlink(path)
    if not os.path.isabs(target):
        target = os.path.join(os.path.dirname(path), target)
    return os.path.normpath(target)


def _store_dir(path: str) -> str:
    """The nix store directory name inside a store path."""
    return path.split(STORE_MARKER, 1)[1].split("/", 1)[0]


def _is_under(path: str, root: str) -> bool:
    """True when `path` is `root` or lives inside it (both sides resolved)."""
    if not root:
        return False
    root = os.path.realpath(root)
    if path == root:
        return True
    return path.startswith(root.rstrip("/") + "/")


def classify(
    path: str,
    *,
    current_generation: str | None,
    repo_dir: str,
    home: str | None = None,
) -> Owner:
    if not os.path.islink(path):
        return Owner("runtime", path, "local file")

    target, exists = _resolve(path)
    if not exists:
        return Owner("broken", target, "target missing")

    # A link that lands on a baked `-source` copy reads frozen content, not the repo.
    if STORE_MARKER in target and SOURCE_MARKER in target:
        return Owner("frozen-store", target, "frozen store copy")

    # Home Manager links hop through a `home-manager-files` store directory; the
    # link itself may resolve straight into the repo, so look at the first hop.
    hop = ""
    try:
        hop = _first_hop(path)
    except OSError:
        hop = ""
    if STORE_MARKER in hop and HM_MARKER in hop:
        hm_source = hop
    elif STORE_MARKER in target and HM_MARKER in target:
        hm_source = target
    else:
        hm_source = ""
    if hm_source:
        if current_generation is not None and current_generation not in _store_dir(hm_source):
            return Owner("home-manager-stale", target, "older Home Manager generation")
        return Owner("home-manager", target, "Home Manager (live repo)")

    if _is_under(target, repo_dir):
        return Owner("dotfiles", target, "dotfiles repo")

    if _is_under(target, home if home is not None else str(Path.home())):
        return Owner("local:user", target, "user-managed")

    if STORE_MARKER in target:
        return Owner("local:tool", target, "nix store path")

    return Owner("local:tool", target, "external target")


@dataclasses.dataclass(frozen=True)
class SpawnRef:
    token: str
    context: str
    line: int


def _split_shell_segments(text: str) -> list[str]:
    parts = [text]
    for sep in SHELL_SEPARATORS:
        nxt: list[str] = []
        for part in parts:
            nxt.extend(part.split(sep))
        parts = nxt
    return [p.strip() for p in parts if p.strip()]


def _shell_tokens(command: str) -> list[str]:
    """The command word of every shell segment, skipping builtins, flags and assignments."""
    tokens: list[str] = []
    for segment in _split_shell_segments(command):
        for word in segment.split():
            if word in SHELL_BUILTINS or word.startswith("-") or "=" in word:
                continue
            tokens.append(word)
            break
    return tokens


def _is_path_token(token: str) -> bool:
    """True for a quoted path argument a spawn may execute."""
    if "/" not in token or token.startswith("-"):
        return False
    if token.endswith(".sh"):
        return True
    home = str(Path.home())
    if token.startswith(f"{home}/.local/bin/") or token.startswith(f"{home}/.config/niri/scripts/"):
        return True
    return "/.local/bin/" in token or "/niri/scripts/" in token


def _context_for(line: str, keyword: str, header: str) -> str:
    """The keybind that owns this spawn, or `startup` when there is none."""
    index = line.find(keyword)
    prefix = line[:index].strip() if index >= 0 else ""
    match = KEYBIND_RE.match(prefix)
    if match:
        return match.group(0)
    return header or "startup"


def extract_spawns(config_text: str) -> list[SpawnRef]:
    """Every command token the niri config spawns, in file order."""
    refs: list[SpawnRef] = []
    header = ""
    for number, line in enumerate(config_text.splitlines(), start=1):
        stripped = line.strip()
        if stripped.startswith("#") or stripped.startswith("//"):
            # A commented out spawn is not a spawn.
            continue
        match = SPAWN_RE.search(line)
        if match is None:
            stripped = line.strip()
            if stripped == "}":
                header = ""
            elif stripped.endswith("{"):
                candidate = KEYBIND_RE.match(stripped)
                if candidate:
                    header = candidate.group(0)
            continue
        keyword = match.group(1)
        quoted = QUOTED_RE.findall(line)
        if not quoted:
            continue
        context = _context_for(line, keyword, "" if keyword.endswith("-at-startup") else header)
        if keyword.startswith("spawn-sh"):
            for token in _shell_tokens(quoted[0]):
                refs.append(SpawnRef(token, context, number))
            continue
        if quoted[0]:
            refs.append(SpawnRef(quoted[0], context, number))
        for token in quoted[1:]:
            if _is_path_token(token):
                refs.append(SpawnRef(token, context, number))
    return refs


def _expand_home(token: str) -> str:
    """Expand a leading `~` or `$HOME` to the user's home directory."""
    if token.startswith("$HOME"):
        return str(Path.home()) + token[len("$HOME"):]
    return os.path.expanduser(token)


def resolve_token(token: str, *, path_env: str | None = None) -> str | None:
    """The absolute path of a spawn token, or None when it cannot be found."""
    expanded = _expand_home(token)
    if "/" in expanded:
        return expanded if os.path.exists(expanded) else None
    return shutil.which(expanded, path=path_env)


@dataclasses.dataclass(frozen=True)
class Finding:
    id: str
    severity: str
    path: str
    detail: str
    fix: str
    command: str


SEVERITIES = ("broken", "stale", "missing", "drift", "orphan", "info")

DEFAULT_EXCLUDE_FILE = str(Path.home() / ".config" / "dot" / "exclude")


def _read_exclusions(exclude_file: str | None) -> tuple[set[str], list[str]]:
    """Directory basenames and absolute path prefixes the user wants skipped."""
    path = exclude_file if exclude_file is not None else DEFAULT_EXCLUDE_FILE
    names: set[str] = set()
    prefixes: list[str] = []
    try:
        with open(path, encoding="utf-8") as handle:
            raw_lines = handle.readlines()
    except OSError:
        return names, prefixes
    for raw in raw_lines:
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("/"):
            prefixes.append(line.rstrip("/"))
        else:
            names.add(line)
    return names, prefixes


def _is_skipped(path: str, name: str, names: set[str], prefixes: list[str]) -> bool:
    if is_excluded(name) or name in names:
        return True
    for prefix in prefixes:
        if path == prefix or path.startswith(prefix + "/"):
            return True
    return False


def _scan_dir(
    directory: str,
    *,
    current_generation: str | None,
    repo_dir: str,
    names: set[str],
    prefixes: list[str],
    depth: int,
    max_depth: int = MAX_SCAN_DEPTH,
    home: str | None = None,
) -> list[Entry]:
    try:
        with os.scandir(directory) as scan:
            children = sorted(scan, key=lambda child: child.name)
    except OSError:
        return []
    found: list[Entry] = []
    for child in children:
        path = child.path
        if _is_skipped(path, child.name, names, prefixes):
            continue
        try:
            is_link = child.is_symlink()
            is_dir = child.is_dir(follow_symlinks=False)
            owner = classify(path, current_generation=current_generation, repo_dir=repo_dir, home=home)
        except OSError:
            continue
        found.append(Entry(path, owner, depth))
        if depth < max_depth and not is_link and is_dir:
            found.extend(_scan_dir(
                path,
                current_generation=current_generation,
                repo_dir=repo_dir,
                names=names,
                prefixes=prefixes,
                depth=depth + 1,
                max_depth=max_depth,
                home=home,
            ))
    return found


def scan_configs(
    roots: list[str],
    *,
    current_generation: str | None,
    repo_dir: str,
    exclude_file: str | None = None,
    home: str | None = None,
    shallow_roots: set[str] | None = None,
) -> list[Entry]:
    """Every config entry down to MAX_SCAN_DEPTH levels below each root.

    A root in `shallow_roots` is only scanned two levels deep: `~/.local/share`
    holds application state, where a broken link is noise rather than a
    configuration mistake.
    """
    names, prefixes = _read_exclusions(exclude_file)
    shallow = shallow_roots or set()
    entries: list[Entry] = []
    for root in roots:
        entries.extend(_scan_dir(
            root,
            current_generation=current_generation,
            repo_dir=repo_dir,
            names=names,
            prefixes=prefixes,
            depth=1,
            max_depth=INVENTORY_DEPTH if root in shallow else MAX_SCAN_DEPTH,
            home=home,
        ))
    return entries


def findings_from_entries(entries: list[Entry]) -> list[Finding]:
    """Turn ownership entries into findings, ordered by severity."""
    findings: list[Finding] = []
    for entry in entries:
        kind = entry.owner.kind
        if kind == "broken":
            findings.append(Finding(
                id="broken-symlink",
                severity="broken",
                path=entry.path,
                detail=f"the link target does not exist: {entry.owner.target}",
                fix=f"rm {entry.path}",
                command=f"rm {entry.path}",
            ))
        elif kind == "home-manager-stale":
            findings.append(Finding(
                id="stale-home-manager",
                severity="stale",
                path=entry.path,
                detail=f"the link points at an older Home Manager generation: {entry.owner.target}",
                fix="re-point the link at the current generation",
                command="",
            ))
        elif kind == "frozen-store":
            findings.append(Finding(
                id="frozen-store-copy",
                severity="stale",
                path=entry.path,
                detail="the app reads a frozen store copy, not your repo — edits do not apply",
                fix="re-point the link at the repo path",
                command="",
            ))
    order = {severity: index for index, severity in enumerate(SEVERITIES)}
    findings.sort(key=lambda finding: order[finding.severity])
    return findings


@dataclasses.dataclass(frozen=True)
class Source:
    """One place software comes from: pacman, the nix profile, desktop files, scripts."""

    name: str
    items: list[str]
    kind: str


TOOL_DIRS: tuple[tuple[str, str], ...] = (
    ("mise", ".local/share/mise/shims"),
    ("uv", ".local/share/uv/tools"),
    ("go", "go/bin"),
    ("vite-plus", ".vite-plus/bin"),
    ("opencode", ".opencode/bin"),
)

PROFILE_BIN_REL = ".local/state/nix/profiles/profile/bin"


COMMAND_TIMEOUT = 120
OUTDATED_TIMEOUT = 45


def _run(cmd: list[str], runner=None, timeout: float = COMMAND_TIMEOUT) -> str:
    """The stdout of a command, or an empty string when it is missing, fails or hangs."""
    run = runner or subprocess.run
    try:
        proc = run(cmd, capture_output=True, text=True, check=False, timeout=timeout)
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout


def _split_lines(text: str) -> list[str]:
    return [line.strip() for line in text.splitlines() if line.strip()]


def _dir_names(directory: str) -> list[str] | None:
    """The sorted entries of a directory, or None when it cannot be read."""
    try:
        names = os.listdir(directory)
    except OSError:
        return None
    return sorted(names)


def default_repo_dir() -> str:
    """The dotfiles repository that ships this script, found by walking up to `.git`."""
    directory = os.path.dirname(os.path.realpath(__file__))
    while True:
        if os.path.exists(os.path.join(directory, ".git")):
            return directory
        parent = os.path.dirname(directory)
        if parent == directory:
            return ""
        directory = parent


def collect_pacman(runner=None) -> dict[str, list[str]]:
    """Installed system packages, foreign (AUR) packages and orphans."""
    return {
        "system": _split_lines(_run(["pacman", "-Qq"], runner)),
        "foreign": _split_lines(_run(["pacman", "-Qmq"], runner)),
        "orphans": _split_lines(_run(["pacman", "-Qdtq"], runner)),
    }


def collect_profile_bins(profile_dir: str | None = None) -> list[str]:
    """The binaries the nix profile puts on PATH, without the hidden wrappers."""
    directory = profile_dir or str(Path.home() / PROFILE_BIN_REL)
    names = _dir_names(directory)
    if names is None:
        return []
    return [name for name in names if not name.startswith(".")]


def collect_desktop_entries(dirs: list[str], *, home: str | None = None) -> list[dict]:
    """The installed applications, read from their `.desktop` files."""
    base = home if home is not None else str(Path.home())
    entries: list[dict] = []
    for directory in dirs:
        names = _dir_names(directory)
        if names is None:
            continue
        for name in names:
            if not name.endswith(".desktop"):
                continue
            path = os.path.join(directory, name)
            try:
                with open(path, encoding="utf-8", errors="replace") as handle:
                    content = handle.read()
            except OSError:
                continue
            label = ""
            for line in content.splitlines():
                if line.startswith("Name="):
                    label = line[len("Name="):].strip()
                    break
            if not label:
                continue
            entries.append({
                "name": label,
                "desktop_file": path,
                "source": "user" if _is_under(os.path.realpath(path), base) else "system",
            })
    return entries


def _git_tracked_paths(bin_dir: str, repo_dir: str) -> set[str]:
    """The repo relative paths of the tracked files inside `bin_dir`."""
    repo = os.path.realpath(repo_dir)
    directory = os.path.realpath(bin_dir)
    try:
        relative = os.path.relpath(directory, repo)
    except ValueError:
        return set()
    if relative.startswith(".."):
        return set()
    output = _run(["git", "-C", repo, "ls-files", "--", relative])
    return {line.strip() for line in output.splitlines() if line.strip()}


def collect_scripts(bin_dir: str, repo_dir: str | None = None) -> dict[str, list[str]]:
    """The scripts in `bin_dir`, split into repo-owned and locally installed."""
    names = _dir_names(bin_dir)
    if names is None:
        return {"repo": [], "local": []}
    repo_root = ""
    tracked: set[str] = set()
    if repo_dir:
        repo_root = os.path.realpath(repo_dir)
        tracked = _git_tracked_paths(bin_dir, repo_root)
    repo: list[str] = []
    local: list[str] = []
    for name in names:
        if name.startswith("."):
            continue
        path = os.path.join(os.path.realpath(bin_dir), name)
        relative = ""
        if repo_root:
            try:
                relative = os.path.relpath(path, repo_root)
            except ValueError:
                relative = ""
        if relative and relative in tracked:
            repo.append(name)
        else:
            local.append(name)
    return {"repo": repo, "local": local}


def collect_outdated(runner=None) -> list[str]:
    """Packages with a newer version available. Reaches the network — opt in only."""
    packages: list[str] = []
    output = _run(["checkupdates"], runner, timeout=OUTDATED_TIMEOUT)
    for line in output.splitlines():
        parts = line.split()
        if parts:
            packages.append(parts[0])
    return packages


def collect_repo_state(repo_dir: str | None = None) -> dict[str, list[str]]:
    """The uncommitted changes in the dotfiles repository."""
    directory = repo_dir if repo_dir is not None else default_repo_dir()
    if not directory:
        return {"modified": [], "untracked": []}
    modified: list[str] = []
    untracked: list[str] = []
    for raw in _run(["git", "-C", directory, "status", "--porcelain"]).splitlines():
        if not raw.strip():
            continue
        # Porcelain lines are `XY<space>path`; the status field may start with a
        # space, so the path starts at index 3 and is only left-trimmed.
        path = raw[2:].lstrip()
        if raw.startswith("??"):
            untracked.append(path)
        else:
            modified.append(path)
    return {"modified": modified, "untracked": untracked}


def tool_dir_paths(home: str | None = None) -> list[str]:
    """The absolute paths of the tool directories, for the given home."""
    base = home if home is not None else str(Path.home())
    return [os.path.join(base, relative) for _, relative in TOOL_DIRS]


def _tool_label(path: str) -> str:
    normalized = os.path.normpath(path)
    for label, relative in TOOL_DIRS:
        if normalized.endswith(relative):
            return label
    return os.path.basename(normalized)


def collect_tool_dirs(dirs: list[str]) -> dict[str, list[str]]:
    """The entries of each tool directory that exists, keyed by tool."""
    found: dict[str, list[str]] = {}
    for directory in dirs:
        names = _dir_names(directory)
        if names is None:
            continue
        found[_tool_label(directory)] = names
    return found


DECLARATIONS_FILE = "nix/modules/packages.nix"

DECLARED_NAME_RE = re.compile(r"^([a-zA-Z0-9_.-]+)$")

PNAME_RE = re.compile(r'pname\s*=\s*"([^"]+)"')

STORE_NAME_RE = re.compile(r"^[a-z0-9]{32}-(.+)$")

VERSION_RE = re.compile(r"-\d")


def _packages_block(text: str) -> list[str] | None:
    """The lines of the `home.packages` list, or None when there is no such list."""
    lines = text.splitlines()
    start = None
    for index, line in enumerate(lines):
        if "home.packages" in line:
            start = index
            break
    if start is None:
        return None
    block: list[str] = []
    opened = False
    for line in lines[start:]:
        stripped = line.strip()
        if not opened:
            if "[" not in stripped:
                continue
            opened = True
            remainder = stripped.split("[", 1)[1].strip().rstrip(";").rstrip("]").strip()
            if remainder:
                block.append(remainder)
            continue
        if stripped.startswith("]"):
            break
        block.append(line)
    return block if opened else None


def parse_declared_packages(text: str) -> set[str]:
    """The package names declared in the `home.packages` list of packages.nix."""
    names: set[str] = set()
    block = _packages_block(text)
    if block is None:
        return names
    in_derivation = False
    for line in block:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        if "mkDerivation" in stripped:
            in_derivation = True
        if in_derivation:
            # A hand written derivation declares its package through `pname`;
            # the attribute names inside the block are not packages.
            match = PNAME_RE.search(stripped)
            if match:
                names.add(match.group(1))
            if stripped.startswith("})"):
                in_derivation = False
            continue
        match = DECLARED_NAME_RE.match(stripped)
        if match:
            names.add(match.group(1))
    return names


def declarations_state(text: str) -> str:
    """`ok`, `no-list` or `empty`: whether the declarations could be read."""
    if _packages_block(text) is None:
        return "no-list"
    return "ok" if parse_declared_packages(text) else "empty"


def _store_package_path(target: str) -> str:
    """The store path of the nix package that provides `target`."""
    index = target.find(STORE_MARKER)
    if index < 0:
        return ""
    package, _, _ = target[index + len(STORE_MARKER):].partition("/")
    return STORE_MARKER + package if package else ""


def _strip_version(name: str) -> str:
    """A nixpkgs package name without its version suffix."""
    match = VERSION_RE.search(name)
    return name[:match.start()] if match else name


def _package_name(store_path: str) -> str:
    """The package name of a nix store path."""
    base = os.path.basename(store_path)
    match = STORE_NAME_RE.match(base)
    return _strip_version(match.group(1) if match else base)


def package_binary_map(profile_dir: str | None = None, runner=None) -> dict[str, list[str]]:
    """The profile binaries each nix package provides, keyed by package name."""
    directory = profile_dir or str(Path.home() / PROFILE_BIN_REL)
    packages: dict[str, list[str]] = {}
    for name in collect_profile_bins(directory):
        target = os.path.realpath(os.path.join(directory, name))
        package = _store_package_path(target)
        if package:
            packages.setdefault(package, []).append(name)
    if not packages:
        return {}
    output = _run(["nix", "path-info", "--json", *sorted(packages)], runner)
    if not output.strip():
        return {}
    try:
        data = json.loads(output)
    except ValueError:
        return {}
    if not isinstance(data, dict):
        return {}
    result: dict[str, list[str]] = {}
    for package_path, binaries in packages.items():
        info = data.get(package_path)
        label = ""
        if isinstance(info, dict):
            name = info.get("name")
            if isinstance(name, str) and name:
                label = _strip_version(name)
        if not label:
            label = _package_name(package_path)
        result.setdefault(label, []).extend(binaries)
    return {label: sorted(bins) for label, bins in sorted(result.items())}


def collect_profile_entries(runner=None) -> list[dict]:
    """The packages the Nix profile holds as its own entries.

    Home Manager installs the whole `home.packages` list as one entry, so the
    entries — not the binaries they happen to carry — are what says whether
    the profile still holds something the declarations do not mention.
    """
    output = _run(["nix", "profile", "list", "--json"], runner)
    if not output.strip():
        return []
    try:
        data = json.loads(output)
    except ValueError:
        return []
    if not isinstance(data, dict):
        return []
    elements = data.get("elements")
    if not isinstance(elements, dict):
        return []
    entries: list[dict] = []
    for name, info in elements.items():
        if not isinstance(info, dict):
            continue
        paths = info.get("storePaths")
        if not isinstance(paths, list):
            continue
        for path in paths:
            if isinstance(path, str) and path:
                entries.append({
                    "name": name,
                    "path": path,
                    "package": _package_name(path),
                })
    return entries


def _is_home_manager_entry(entry: dict) -> bool:
    """True for the profile entry Home Manager owns.

    Home Manager installs its packages as the entry `home-manager-path`, so
    that entry is never something the declarations have to mention.
    """
    name = entry.get("package") or entry.get("name") or ""
    return name in ("home-manager", "home-manager-path") or name.endswith("-home-manager-path")


def _same_package(declared: str, other: str) -> bool:
    """True when `other` names the same package as `declared`.

    nixpkgs is not consistent about package names: the attribute `antigravity`
    ships the package `antigravity-ide`, `nixfmt-rfc-style` ships `nixfmt`, and
    the python packages carry a `python3.14-` prefix.
    """
    if declared == other:
        return True
    return (
        other.startswith(declared + "-")
        or declared.startswith(other + "-")
        or other.endswith("-" + declared)
        or declared.endswith("-" + other)
    )


def nix_drift(
    declared: set[str],
    installed: set[str],
    package_bins: dict[str, list[str]],
    profile_entries: list[dict] | None = None,
) -> list[Finding]:
    """The drift between the declared packages and the ones the profile provides.

    `installed` are the binaries the profile carries, `package_bins` maps every
    nix package to the binaries it provides, and `profile_entries` are the
    packages the profile holds as its own entries. Home Manager installs its
    whole `home.packages` list as a single entry, so only the entries say
    whether the profile still holds something the declarations do not mention.
    """
    if not package_bins:
        # Without the package map a declared package cannot be matched to its
        # binary — `neovim` ships `nvim`, `ripgrep` ships `rg`. Calling that a
        # drift would be a lie, so nothing is claimed here; the caller reports
        # that the nix layer could not be read.
        return []
    findings: list[Finding] = []
    for package in sorted(declared):
        candidates = set(package_bins.get(package) or [package])
        satisfied = any(candidate in installed for candidate in candidates)
        if not satisfied:
            satisfied = any(_same_package(package, binary) for binary in installed)
        if not satisfied:
            findings.append(Finding(
                id="nix-not-installed",
                severity="drift",
                path=DECLARATIONS_FILE,
                detail=f"`{package}` declared in nix/modules/packages.nix but not installed",
                fix="dot pkg sync",
                command="",
            ))

    for entry in profile_entries or []:
        if _is_home_manager_entry(entry):
            continue
        package = entry.get("package") or ""
        if not package:
            continue
        if any(_same_package(name, package) for name in declared):
            continue
        binaries = package_bins.get(package) or []
        detail = (
            f"`{package}` is installed in the Nix profile but not declared "
            "in packages.nix"
        )
        if binaries:
            detail += f" ({', '.join(binaries)})"
        findings.append(Finding(
            id="nix-undeclared",
            severity="drift",
            path=DECLARATIONS_FILE,
            detail=detail,
            fix=f"add {package} to nix/modules/packages.nix",
            command="",
        ))
    return findings


COLOR = {
    "broken": "31",         # red
    "stale": "35",          # magenta
    "missing": "38;5;208",  # orange
    "drift": "33",          # yellow
    "ok": "32",             # green
    "muted": "2",           # dim
}

HEADLINE_SEVERITIES = ("broken", "stale", "missing", "drift")

COUNT_KEYS = ("broken", "stale", "missing", "drift", "info")

RUNTIME_OWNER = "runtime"

TOP_CLI_LIMIT = 12

# The tools a person reaches for daily. They lead the "Top CLI" line, because
# an alphabetical slice of the profile is mostly man pages and wrappers.
CURATED_CLI = (
    "bat", "btop", "delta", "docker", "eza", "fd", "ffmpeg", "fzf", "git", "gh",
    "htop", "jq", "lazygit", "nvim", "rg", "tmux", "tree", "yq", "zoxide",
)


@dataclasses.dataclass(frozen=True)
class Inventory:
    """Everything `dot` knows about this machine."""
    apps: list[dict]
    cli: list[Source]
    scripts: dict[str, list[str]]
    configs: list[Entry]
    findings: list[Finding]
    meta: dict


def _use_color() -> bool:
    """True when the output may carry color: a terminal, and no NO_COLOR."""
    if os.environ.get("NO_COLOR"):
        return False
    try:
        return sys.stdout.isatty()
    except (AttributeError, ValueError):
        return False


def _paint(text: str, key: str) -> str:
    code = COLOR.get(key)
    if not code or not _use_color():
        return text
    return f"\033[{code}m{text}\033[0m"


def _severity_counts(findings: list[Finding]) -> dict[str, int]:
    counts = {key: 0 for key in COUNT_KEYS}
    for finding in findings:
        if finding.severity in counts:
            counts[finding.severity] += 1
    return counts


def _managed_configs(inventory: Inventory) -> list[Entry]:
    """The config entries the user or a tool owns — not the app runtime dirs.

    Only the first two levels are the inventory. The third level exists to
    find broken links deeper in an app's own directory.
    """
    return [
        entry for entry in inventory.configs
        if entry.owner.kind != RUNTIME_OWNER and entry.depth <= INVENTORY_DEPTH
    ]


def _breakdown(counts: dict[str, int]) -> str:
    ordered = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
    return " · ".join(f"{name} {count}" for name, count in ordered)


def _count_line(label: str, count: int, breakdown: str = "") -> str:
    line = f"  {label:<16}{count:>6}"
    return f"{line}     {breakdown}" if breakdown else line


def _top_cli(inventory: Inventory) -> list[str]:
    """The command line tools worth remembering: the profile first, then the shims."""
    names: list[str] = []
    for kind in ("cli", "binary"):
        for source in inventory.cli:
            if source.kind == kind:
                names.extend(source.items)
        if names:
            break
    available = set(names)
    curated = [name for name in CURATED_CLI if name in available]
    rest = sorted(available - set(curated))
    return curated + rest


def _inventory_counts(inventory: Inventory) -> list[str]:
    app_sources: dict[str, int] = {}
    for app in inventory.apps:
        source = app.get("source", "unknown")
        app_sources[source] = app_sources.get(source, 0) + 1
    packages = {s.name: len(s.items) for s in inventory.cli if s.kind in ("package", "cli")}
    tooling = {s.name: len(s.items) for s in inventory.cli if s.kind == "binary"}
    managed = _managed_configs(inventory)
    owners: dict[str, int] = {}
    for entry in managed:
        owners[entry.owner.kind] = owners.get(entry.owner.kind, 0) + 1
    groups = {group: len(names) for group, names in inventory.scripts.items()}
    return [
        _count_line("Desktop apps", len(inventory.apps), _breakdown(app_sources)),
        _count_line("CLI packages", sum(packages.values()), _breakdown(packages)),
        _count_line("Tooling", sum(tooling.values()), _breakdown(tooling)),
        _count_line("AUR / foreign", int(inventory.meta.get("foreign", 0))),
        _count_line("Orphans", int(inventory.meta.get("orphans", 0)), "safe to remove"),
        _count_line("Managed configs", len(managed), _breakdown(owners)),
        _count_line("Local scripts", sum(groups.values()), _breakdown(groups)),
    ]


def _full_lists(inventory: Inventory) -> list[str]:
    lines = [""]
    lines.append(f"  Desktop apps ({len(inventory.apps)}):")
    for app in inventory.apps:
        lines.append(f"    {app.get('name', '')}")
    for source in inventory.cli:
        lines.append(f"  {source.name} ({len(source.items)}):")
        for item in source.items:
            lines.append(f"    {item}")
    for group, names in inventory.scripts.items():
        lines.append(f"  {group} scripts ({len(names)}):")
        for name in names:
            lines.append(f"    {name}")
    managed = _managed_configs(inventory)
    lines.append(f"  Managed configs ({len(managed)}):")
    for entry in managed:
        lines.append(f"    {entry.path} → {entry.owner.target}  ({entry.owner.kind})")
    return lines


def render_list(inventory: Inventory, *, wide: bool = False, show_all: bool = False) -> str:
    """The `dot list` view: what is installed, grouped by source."""
    distro = inventory.meta.get("distro", "unknown")
    host = inventory.meta.get("host", "unknown")
    lines = [
        f"System inventory · {distro} · {host}",
        "─" * 60,
    ]
    lines.extend(_inventory_counts(inventory))
    top_cli = _top_cli(inventory)
    if top_cli:
        lines.append("")
        lines.append("  Top CLI: " + "  ".join(top_cli if wide else top_cli[:TOP_CLI_LIMIT]))
    if show_all:
        lines.extend(_full_lists(inventory))
    else:
        lines.append("")
        lines.append("  Full lists: dot list --all --cli")
    return "\n".join(lines)


def render_status(inventory: Inventory) -> str:
    """The `dot status` view: what is broken, stale, missing or drifted."""
    counts = _severity_counts(inventory.findings)
    total = sum(counts[key] for key in HEADLINE_SEVERITIES)
    lines: list[str] = []
    if total == 0:
        headline = "● no problems" if counts["info"] else "● no findings"
        lines.append(_paint(headline, "ok"))
    else:
        parts = [f"{counts[key]} {key}" for key in HEADLINE_SEVERITIES if counts[key]]
        worst = next((key for key in HEADLINE_SEVERITIES if counts[key]), "muted")
        lines.append(_paint(f"● {total} findings — {', '.join(parts)}", worst))
    for severity in SEVERITIES:
        group = [finding for finding in inventory.findings if finding.severity == severity]
        if not group:
            continue
        lines.append("")
        lines.append(_paint(f"{severity.upper()} ({len(group)})", severity))
        marker = "✗" if severity in ("broken", "missing") else "~"
        for finding in group:
            lines.append(f"  {marker} {finding.path}")
            if finding.detail:
                lines.append(f"      {finding.detail}")
            if finding.fix:
                lines.append(f"      fix: {finding.fix}")
    return "\n".join(lines)


def _sections(inventory: Inventory) -> dict:
    cli_items = [
        {"source": source.name, "name": item}
        for source in inventory.cli
        for item in source.items
    ]
    script_items = [
        {"group": group, "name": name}
        for group, names in inventory.scripts.items()
        for name in names
    ]
    config_items = [
        {"path": entry.path, "owner": entry.owner.kind, "target": entry.owner.target}
        for entry in _managed_configs(inventory)
    ]
    return {
        "apps": {"count": len(inventory.apps), "items": list(inventory.apps)},
        "cli": {"count": len(cli_items), "items": cli_items},
        "scripts": {"count": len(script_items), "items": script_items},
        "configs": {"count": len(config_items), "items": config_items},
    }


def _summary(inventory: Inventory, sections: dict | None = None) -> dict:
    by_owner: dict[str, int] = {}
    for entry in inventory.configs:
        kind = entry.owner.kind
        by_owner[kind] = by_owner.get(kind, 0) + 1
    by_source = {source.name: len(source.items) for source in inventory.cli}
    blocks = sections if sections is not None else _sections(inventory)
    total = sum(section["count"] for section in blocks.values())
    return {"total": total, "by_source": by_source, "by_owner": by_owner}


def inventory_json(inventory: Inventory, *, command: str) -> dict:
    """The machine readable view, in the frozen shape of spec §7.6."""
    sections = _sections(inventory)
    data = {
        "tool": "dot",
        "version": TOOL_VERSION,
        "command": command,
        "generated_at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "summary": _summary(inventory, sections),
        "sections": sections,
    }
    if command == "status":
        counts = _severity_counts(inventory.findings)
        data["ok"] = not any(counts[key] for key in HEADLINE_SEVERITIES)
        data["counts"] = counts
        data["findings"] = [
            {
                "id": finding.id,
                "severity": finding.severity,
                "path": finding.path,
                "detail": finding.detail,
                "fix": finding.fix,
                "command": finding.command,
            }
            for finding in inventory.findings
        ]
    return data


HM_PROFILE_REL = ".local/state/nix/profiles/home-manager"
NIRI_CONFIG_REL = ".config/niri/config.kdl"
DESKTOP_DIRS = (".local/share/applications",)
SYSTEM_DESKTOP_DIR = "/usr/share/applications"
SECTION_ORDER = ("apps", "cli", "configs", "scripts", "sources")
OWNER_TOOL = "local:tool"


def current_generation(home: str | None = None) -> str | None:
    """The hash of the Home Manager generation this machine is on."""
    base = home if home is not None else str(Path.home())
    generation = os.path.realpath(os.path.join(base, HM_PROFILE_REL))
    if not os.path.isdir(generation):
        return None
    home_files = os.path.realpath(os.path.join(generation, "home-files"))
    directory = os.path.basename(home_files)
    if not directory.endswith(HM_MARKER):
        return None
    return directory[: -len(HM_MARKER)]


def _distro_name() -> str:
    """The name of the running distribution."""
    try:
        with open("/etc/os-release", encoding="utf-8") as handle:
            for line in handle:
                if line.startswith("NAME="):
                    return line.split("=", 1)[1].strip().strip('"')
    except OSError:
        pass
    return "unknown"


def _host_name() -> str:
    """The name of this machine."""
    try:
        return os.uname().nodename
    except AttributeError:
        return "unknown"


def _package_for_binary(name: str, runner=None) -> str:
    """The package that provides a binary, when the pacman file database knows it."""
    for line in _run(["pacman", "-F", name], runner).splitlines():
        fields = line.split()
        if fields and "/" in fields[0]:
            return fields[0].split("/")[-1]
    return name


def _spawn_findings(config_path: str, *, lookup_package: bool = True) -> list[Finding]:
    """The binaries the compositor spawns that are not installed.

    `lookup_package` asks pacman which package provides the binary, so the fix
    names a real package. The health probe switches it off: the bar calls the
    probe every ten seconds, and pacman costs seconds. The binary name is the
    package name in nearly every case, so the hint stays usable.
    """
    try:
        with open(config_path, encoding="utf-8", errors="replace") as handle:
            text = handle.read()
    except OSError:
        return []
    findings: list[Finding] = []
    seen: set[str] = set()
    for ref in extract_spawns(text):
        if ref.token in seen:
            continue
        seen.add(ref.token)
        if resolve_token(ref.token) is not None:
            continue
        if "/" in ref.token:
            detail = f"the compositor spawns `{ref.token}` ({ref.context}) — the file does not exist"
            fix = f"create or restore {ref.token}"
            command = ""
        else:
            package = _package_for_binary(ref.token) if lookup_package else ref.token
            detail = f"the compositor spawns `{ref.token}` ({ref.context}) — not installed"
            fix = f"sudo pacman -S {package}"
            command = fix
        findings.append(Finding(
            id="missing-binary",
            severity="missing",
            path=ref.token,
            detail=f"{detail} (line {ref.line})",
            fix=fix,
            command=command,
        ))
    return findings


def _nix_findings(
    repo: str,
    profile_dir: str,
    profile_bins: list[str],
    package_bins: dict[str, list[str]] | None = None,
) -> list[Finding]:
    """The drift between the declared nix packages and the installed ones.

    The nix layer is read in three steps: the declarations, the profile and
    the package map that connects them. Each one can fail on its own, and a
    step that cannot be read is reported as information. Calling it drift
    would be a claim the tool cannot back.
    """
    if not repo:
        return []
    try:
        with open(os.path.join(repo, DECLARATIONS_FILE), encoding="utf-8") as handle:
            text = handle.read()
    except OSError:
        return []
    state = declarations_state(text)
    if state == "no-list":
        return [Finding(
            id="nix-declarations-unreadable",
            severity="info",
            path=DECLARATIONS_FILE,
            detail="the declaration file has no home.packages list, nothing to compare",
            fix="",
            command="",
        )]
    declared = parse_declared_packages(text)
    if state == "empty":
        return [Finding(
            id="nix-no-declarations",
            severity="info",
            path=DECLARATIONS_FILE,
            detail="the declaration file lists no packages",
            fix="",
            command="",
        )]
    if not profile_bins:
        return [Finding(
            id="nix-not-present",
            severity="info",
            path=DECLARATIONS_FILE,
            detail="Nix: not present, the profile is gone, so the declarations were not checked",
            fix="",
            command="",
        )]
    mapping = package_binary_map(profile_dir) if package_bins is None else package_bins
    if not mapping:
        return [Finding(
            id="nix-unverified",
            severity="info",
            path=DECLARATIONS_FILE,
            detail=(
                f"the nix CLI could not map the profile, {len(declared)} declared "
                "packages could not be verified"
            ),
            fix="",
            command="",
        )]
    entries = collect_profile_entries()
    return nix_drift(declared, set(profile_bins), mapping, entries)


def _repo_dirty_finding(repo: str) -> Finding | None:
    """The uncommitted changes in the repository — information, never a failure."""
    if not repo:
        return None
    state = collect_repo_state(repo)
    modified = state["modified"]
    if not modified:
        return None
    listed = ", ".join(modified[:5])
    if len(modified) > 5:
        listed += f" and {len(modified) - 5} more"
    return Finding(
        id="repo-dirty",
        severity="info",
        path=repo,
        detail=f"{len(modified)} modified file(s): {listed}",
        fix=f"git -C {repo} diff",
        command=f"git -C {repo} diff",
    )


def _sort_findings(findings: list[Finding]) -> list[Finding]:
    """Order the findings by severity, the way `dot status` groups them."""
    order = {severity: index for index, severity in enumerate(SEVERITIES)}
    return sorted(findings, key=lambda finding: order.get(finding.severity, len(SEVERITIES)))


# ── health ──


HEALTH_TEXT = "●"
HEALTH_SEVERITIES = ("broken", "stale", "missing")


def scan_home_configs(base: str, repo: str) -> list[Entry]:
    """The config entries of this home directory.

    One scan, one rule: `~/.config` is read three levels deep, `~/.local/share`
    only two, because a broken link in an application's state directory is
    noise rather than a configuration mistake.
    """
    return scan_configs(
        [os.path.join(base, ".config"), os.path.join(base, ".local", "share")],
        current_generation=current_generation(base),
        repo_dir=repo,
        home=base,
        shallow_roots={os.path.join(base, ".local", "share")},
    )


@dataclasses.dataclass(frozen=True)
class Health:
    """The cheap health of the machine: the links and the spawn targets."""

    ok: bool
    counts: dict[str, int]
    findings: list[Finding]
    text: str
    tooltip: str
    style: str


def collect_health(*, home: str | None = None, repo_dir: str | None = None) -> Health:
    """The cheap health probe: the config links and the compositor spawns only.

    The bar calls this on a timer, so it must not run pacman, nix or git: a
    full `dot status` costs more than a second, this costs about a tenth.
    """
    base = os.path.abspath(home) if home is not None else str(Path.home())
    repo = repo_dir if repo_dir is not None else default_repo_dir()
    if repo and not os.path.isdir(repo):
        repo = ""
    entries = scan_home_configs(base, repo)
    findings = findings_from_entries(entries)
    findings.extend(_spawn_findings(os.path.join(base, NIRI_CONFIG_REL), lookup_package=False))
    counts = {key: 0 for key in HEALTH_SEVERITIES}
    for finding in findings:
        if finding.severity in counts:
            counts[finding.severity] += 1
    broken = counts["broken"] + counts["stale"] + counts["missing"]
    if broken:
        parts = [f"{counts[key]} {key}" for key in HEALTH_SEVERITIES if counts[key]]
        tooltip = "dot: " + " · ".join(parts)
        style = "bad"
    else:
        tooltip = "dot: no problems"
        style = "ok"
    return Health(
        ok=not broken,
        counts=counts,
        findings=findings,
        text=HEALTH_TEXT,
        tooltip=tooltip,
        style=style,
    )


def health_json(health: Health) -> dict:
    """Exactly the three keys a waybar json custom module reads."""
    return {"text": health.text, "tooltip": health.tooltip, "class": health.style}


def render_health(health: Health) -> str:
    """The one line a terminal shows."""
    if health.ok:
        return f"{health.text} no problems"
    total = sum(health.counts[key] for key in HEALTH_SEVERITIES)
    return f"{health.text} {total} problems"


# ── package editing ──

PACKAGE_NAME_RE = re.compile(r"^[A-Za-z0-9_][A-Za-z0-9_.'-]*$")
PACKAGE_LIST_RE = re.compile(r"home\.packages\s*=\s*with\s+pkgs\s*;")
DEFAULT_PACKAGE_INDENT = "    "


@dataclasses.dataclass(frozen=True)
class PackageEntry:
    """One bare package name inside the home.packages list."""

    name: str
    line: int
    indent: str


class PackageEditError(Exception):
    """The package list cannot be edited the way the caller asked."""


def _package_list_bounds(text: str) -> tuple[int, int] | None:
    """The line numbers of the home.packages list, opening bracket included."""
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if not PACKAGE_LIST_RE.search(line):
            continue
        if "[" not in line:
            continue
        if "]" in line[line.index("[") + 1:]:
            # A one-line list has no interior to insert into, and the search
            # below would anchor on the next list's closing bracket.
            return None
        for end in range(index + 1, len(lines)):
            if lines[end].strip().startswith("]"):
                return index, end
    return None


def package_entries(text: str) -> list[PackageEntry]:
    """The bare package names of the home.packages list, in file order.

    An entry that is an expression (a derivation written over several lines)
    is not a name this tool can add or remove, so it is not an entry.
    """
    bounds = _package_list_bounds(text)
    if bounds is None:
        return []
    start, end = bounds
    lines = text.splitlines()
    entries: list[PackageEntry] = []
    depth = 0
    for number in range(start + 1, end):
        raw = lines[number]
        stripped = raw.strip()
        depth += raw.count("(") - raw.count(")")
        if depth != 0 or not stripped or stripped.startswith("#"):
            continue
        if not PACKAGE_NAME_RE.match(stripped):
            continue
        entries.append(PackageEntry(
            name=stripped,
            line=number + 1,
            indent=raw[: len(raw) - len(raw.lstrip())],
        ))
    return entries


def package_block(text: str) -> str:
    """The text inside the home.packages list."""
    bounds = _package_list_bounds(text)
    if bounds is None:
        return ""
    start, end = bounds
    return "\n".join(text.splitlines()[start + 1: end])


def _declares(block: str, name: str) -> bool:
    """True when the list already mentions this name, as an entry or an expression."""
    return re.search(rf"(?<![\w.'-]){re.escape(name)}(?![\w.'-])", block) is not None


def add_packages(text: str, names: list[str]) -> tuple[str, list[str]]:
    """Add the names that are not declared yet; returns the new text and what was added."""
    bounds = _package_list_bounds(text)
    if bounds is None:
        raise PackageEditError(f"{DECLARATIONS_FILE} has no home.packages list")
    entries = package_entries(text)
    block = package_block(text)
    declared = {entry.name for entry in entries}
    wanted = [name for name in dict.fromkeys(names)
              if name not in declared and not _declares(block, name)]
    if not wanted:
        return text, []
    lines = text.splitlines()
    indent = entries[-1].indent if entries else DEFAULT_PACKAGE_INDENT
    insert_at = entries[-1].line if entries else bounds[0] + 1
    for offset, name in enumerate(wanted):
        lines.insert(insert_at + offset, f"{indent}{name}")
    return "\n".join(lines) + ("\n" if text.endswith("\n") else ""), wanted


def remove_packages(text: str, names: list[str]) -> tuple[str, list[str]]:
    """Remove the named packages; returns the new text and what was removed.

    A name that is present but is not a bare entry cannot be removed without
    the caller editing the file by hand, so it is refused.
    """
    bounds = _package_list_bounds(text)
    if bounds is None:
        raise PackageEditError(f"{DECLARATIONS_FILE} has no home.packages list")
    entries = package_entries(text)
    by_name = {entry.name: entry for entry in entries}
    block = package_block(text)
    removed: list[str] = []
    for name in dict.fromkeys(names):
        if name in by_name:
            removed.append(name)
        elif name in block:
            raise PackageEditError(
                f"{name} is not a plain entry — it is an expression; edit the file by hand")
    if not removed:
        return text, []
    lines = text.splitlines()
    for entry in sorted((by_name[name] for name in removed), key=lambda e: -e.line):
        del lines[entry.line - 1]
    return "\n".join(lines) + ("\n" if text.endswith("\n") else ""), removed


# ── dot pkg ──

SWITCH_TIMEOUT = 900
NIX_EVAL_TIMEOUT = 120


def _nix_expr(repo_dir: str, expression: str) -> str:
    """A nix expression that reads the flake of this repository."""
    return f'(builtins.getFlake "{repo_dir}").{expression}'


def nix_attribute_name(name: str, repo_dir: str, runner=None) -> str | None:
    """The nixpkgs version of an attribute, or None when nixpkgs has no such attribute.

    The attribute is looked up in the flake's own nixpkgs, so a name that
    resolves here is a name the configuration can build.
    """
    expression = _nix_expr(
        repo_dir,
        f"inputs.nixpkgs.legacyPackages.${{builtins.currentSystem}}.{name}.name",
    )
    output = _run(["nix", "eval", "--impure", "--raw", "--expr", expression],
                  runner, timeout=NIX_EVAL_TIMEOUT).strip()
    return output or None


def home_manager_configurations(repo_dir: str, runner=None) -> list[str]:
    """The homeConfigurations the flake exposes."""
    expression = _nix_expr(repo_dir, "outputs.homeConfigurations")
    output = _run(["nix", "eval", "--impure", "--json", "--expr",
                   f"builtins.attrNames {expression}"],
                  runner, timeout=NIX_EVAL_TIMEOUT).strip()
    if not output:
        return []
    try:
        names = json.loads(output)
    except json.JSONDecodeError:
        return []
    return [str(name) for name in names] if isinstance(names, list) else []


def run_home_manager_switch(repo_dir: str, config: str, runner=None) -> tuple[bool, str]:
    """Run `home-manager switch`; returns whether it worked and what it said."""
    cmd = ["home-manager", "switch", "--flake", f"{repo_dir}#{config}"]
    run = runner or subprocess.run
    try:
        proc = run(cmd, capture_output=True, text=True, check=False, timeout=SWITCH_TIMEOUT)
    except (FileNotFoundError, OSError, subprocess.TimeoutExpired) as error:
        return False, str(error)
    output = (proc.stdout or "") + (proc.stderr or "")
    return proc.returncode == 0, output


def package_diff(before: str, after: str, path: str) -> str:
    """A unified diff of the change, for the confirmation prompt."""
    diff = difflib.unified_diff(
        before.splitlines(keepends=True),
        after.splitlines(keepends=True),
        fromfile=f"a/{path}",
        tofile=f"b/{path}",
    )
    return "".join(diff)


def confirm(question: str, *, assume_yes: bool = False, stream=None) -> bool:
    """Ask the question; without a terminal the answer is no."""
    if assume_yes:
        return True
    source = stream if stream is not None else sys.stdin
    try:
        interactive = source.isatty()
    except (AttributeError, ValueError):
        interactive = False
    if not interactive:
        print(f"{question} [y/N] (no terminal: refusing)")
        return False
    print(f"{question} [y/N] ", end="", flush=True)
    answer = source.readline().strip().lower()
    return answer in ("y", "yes")


def resolve_package_name(name: str, package_bins: dict[str, list[str]]) -> str | None:
    """The package that provides a binary, when the profile knows one."""
    for package, binaries in package_bins.items():
        if name in binaries:
            return package
    return None


def _profile_state(base: str) -> tuple[set[str], dict[str, list[str]]]:
    """The binaries the profile carries and the nix package map that names them."""
    bins = set(collect_profile_bins(os.path.join(base, PROFILE_BIN_REL)))
    return bins, package_binary_map()


def _is_installed(name: str, bins: set[str], package_bins: dict[str, list[str]]) -> bool:
    """True when the profile carries this package under any of its binaries."""
    candidates = set(package_bins.get(name) or [name])
    if any(candidate in bins for candidate in candidates):
        return True
    return any(_same_package(name, binary) for binary in bins)


def _package_drift(declared: set[str], bins: set[str],
                   package_bins: dict[str, list[str]]) -> list[Finding]:
    return nix_drift(declared, bins, package_bins, collect_profile_entries())


def _drift_lines(findings: list[Finding]) -> list[str]:
    if not findings:
        return []
    return ["", "drift:"] + [f"  {finding.detail}" for finding in findings]


def pkg_list_output(*, home: str | None = None, repo_dir: str | None = None) -> str:
    """The declared packages, whether the profile has them, and the drift."""
    base = home if home is not None else str(Path.home())
    repo = repo_dir if repo_dir is not None else default_repo_dir()
    path = os.path.join(repo, DECLARATIONS_FILE)
    try:
        with open(path, encoding="utf-8") as handle:
            text = handle.read()
    except OSError:
        return f"{DECLARATIONS_FILE} cannot be read: {repo}"
    declared = parse_declared_packages(text)
    bins, package_bins = _profile_state(base)
    lines = [f"Declared packages ({len(declared)}):"]
    for name in sorted(declared):
        mark = "installed" if _is_installed(name, bins, package_bins) else "declared"
        lines.append(f"  {name}  ({mark})")
    lines.extend(_drift_lines(_package_drift(declared, bins, package_bins)))
    return "\n".join(lines)


def _write_text_atomic(path: str, text: str) -> None:
    """Replace the file in one step, so a failure never leaves it truncated."""
    temporary = f"{path}.dot-new"
    try:
        with open(temporary, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            try:
                os.unlink(temporary)
            except OSError:
                pass


def apply_package_change(
    repo_dir: str,
    new_text: str,
    old_text: str,
    config: str,
    *,
    runner=None,
) -> tuple[bool, str]:
    """Write the file, run the switch, and restore the file when the switch fails."""
    path = os.path.join(repo_dir, DECLARATIONS_FILE)
    try:
        _write_text_atomic(path, new_text)
    except OSError as error:
        return False, f"cannot write {path}: {error}"
    try:
        ok, output = run_home_manager_switch(repo_dir, config, runner=runner)
    except BaseException:
        # Ctrl-C during a long build must not leave the declaration edited.
        try:
            _write_text_atomic(path, old_text)
        except OSError:
            pass
        raise
    if not ok:
        try:
            _write_text_atomic(path, old_text)
        except OSError as error:
            return False, f"the switch failed and the file could not be restored: {error}\n{output}"
        return False, f"the switch failed, the file was restored\n{output}"
    return True, output


def pkg_main(args) -> int:
    """The `dot pkg` command: the only part of `dot` that changes anything."""
    repo = default_repo_dir()
    if not repo:
        print("the dotfiles repository cannot be found", file=sys.stderr)
        return 1
    path = os.path.join(repo, DECLARATIONS_FILE)
    if args.pkg_command == "list":
        print(pkg_list_output(repo_dir=repo))
        return 0
    config = args.config or ""
    if not config:
        configs = home_manager_configurations(repo)
        if len(configs) == 1:
            config = configs[0]
        elif not configs:
            print("the flake exposes no home configuration", file=sys.stderr)
            return 1
        else:
            print(f"the flake exposes {', '.join(configs)} — choose one with --config",
                  file=sys.stderr)
            return 1
    try:
        with open(path, encoding="utf-8") as handle:
            before = handle.read()
    except OSError as error:
        print(f"cannot read {path}: {error}", file=sys.stderr)
        return 1
    if args.pkg_command == "sync":
        print(f"running home-manager switch for {repo}#{config}")
        ok, output = run_home_manager_switch(repo, config)
        print(output)
        if not ok:
            return 1
        declared = parse_declared_packages(before)
        bins, package_bins = _profile_state(str(Path.home()))
        for line in _drift_lines(_package_drift(declared, bins, package_bins)):
            print(line)
        return 0
    try:
        if args.pkg_command == "rm":
            # Removal needs no nixpkgs lookup: the file says what is declared,
            # and an expression entry is refused by the editor itself.
            after, changed = remove_packages(before, args.names)
        else:
            declared = parse_declared_packages(before)
            block = package_block(before)
            names = []
            for name in args.names:
                if name in declared or _declares(block, name):
                    # Already declared: nothing to add, and nothing to validate.
                    names.append(name)
                    continue
                resolved = nix_attribute_name(name, repo)
                if resolved is None:
                    mapped = resolve_package_name(name, package_binary_map())
                    if mapped is None:
                        print(f"{name} is not a nixpkgs package", file=sys.stderr)
                        return 1
                    resolved = nix_attribute_name(mapped, repo)
                    if resolved is None:
                        print(f"{name} is not a nixpkgs package", file=sys.stderr)
                        return 1
                    name = mapped
                names.append(name)
            after, changed = add_packages(before, names)
    except PackageEditError as error:
        print(str(error), file=sys.stderr)
        return 1
    if not changed:
        print("nothing to change")
        return 0
    diff = package_diff(before, after, DECLARATIONS_FILE)
    print(diff)
    if args.dry_run:
        return 0
    if not confirm("Apply this change?", assume_yes=args.yes):
        print("nothing was changed")
        return 1
    ok, output = apply_package_change(repo, after, before, config)
    print(output)
    if not ok:
        print("the change was not applied", file=sys.stderr)
        return 1
    print("the profile was updated")
    return 0


# ── browse ──

BROWSE_KINDS = ("app", "cli", "script", "config")


def browse_rows(*, home: str | None = None, repo_dir: str | None = None) -> list[dict]:
    """The items the browser offers: apps, cli tools, scripts and config files.

    The pacman query is the only expensive step and stays inside D8's budget:
    one `pacman -Qq` states what the system has, and the profile and tool
    directories add what pacman does not own.
    """
    base = os.path.abspath(home) if home is not None else str(Path.home())
    repo = repo_dir if repo_dir is not None else default_repo_dir()
    rows: list[dict] = []
    app_dirs = [os.path.join(base, relative) for relative in DESKTOP_DIRS]
    app_dirs.append(SYSTEM_DESKTOP_DIR)
    for app in collect_desktop_entries(app_dirs, home=base):
        name = app.get("name", "")
        desktop_file = app.get("desktop_file", "")
        rows.append({
            "id": f"app:{name}",
            "kind": "app",
            "label": name,
            "detail": app.get("source", ""),
            "target": os.path.basename(desktop_file)[:-len(".desktop")] if desktop_file else name,
        })
    cli: dict[str, str] = {}
    for name in _run(["pacman", "-Qq"]).splitlines():
        if name.strip():
            cli[name.strip()] = "pacman"
    for tool, items in collect_tool_dirs(tool_dir_paths(base)).items():
        for name in items:
            cli.setdefault(name, tool)
    for name in collect_profile_bins(os.path.join(base, PROFILE_BIN_REL)):
        cli[name] = "nix"
    for name in sorted(cli):
        rows.append({"id": f"cli:{name}", "kind": "cli", "label": name,
                     "detail": cli[name], "target": name})
    scripts = collect_scripts(os.path.join(base, ".local", "bin"), repo or None)
    for group, script_names in scripts.items():
        for name in script_names:
            rows.append({"id": f"script:{name}", "kind": "script", "label": name,
                         "detail": group, "target": name})
    for entry in scan_home_configs(base, repo):
        # `~/.local/share` is application state: a browser over configuration
        # must not list it. Everything under `~/.config` is browsable, plain
        # files included, because a config the user has not linked yet is
        # still a config.
        if entry.path.startswith(os.path.join(base, ".local", "share") + os.sep):
            continue
        rows.append({"id": f"config:{entry.path}", "kind": "config",
                     "label": entry.path, "detail": entry.owner.kind,
                     "target": entry.owner.target})
    return rows


def _run_with_input(cmd: list[str], stdin_text: str) -> str:
    """Run a command and feed it text on stdin."""
    proc = subprocess.run(cmd, input=stdin_text, capture_output=True, text=True, check=False)
    return proc.stdout


def run_fzf(rows: list[str], *, runner=None) -> list[str] | None:
    """Feed the rows to fzf and return the chosen ids.

    None means fzf is not installed, so the caller can print the rows
    instead; an empty list means fzf ran and nothing was chosen.
    """
    script = os.path.realpath(__file__)
    cmd = [
        "fzf",
        "--delimiter=\t",
        "--with-nth=2..",
        "--multi",
        "--print0",
        f"--preview={script} show {{1}}",
    ]
    run = runner or _run_with_input
    try:
        output = run(cmd, "\n".join(rows) + "\n")
    except (FileNotFoundError, OSError):
        return None
    # fzf prints the whole line; the id is its first tab-separated field.
    return [record.split("\t", 1)[0] for record in output.split("\0") if record.strip()]


def show_item(item_id: str, *, home=None, repo_dir=None) -> str:
    """The details of one item, for the browser preview."""
    base = os.path.abspath(home) if home is not None else str(Path.home())
    repo = repo_dir if repo_dir is not None else default_repo_dir()
    kind, _, name = item_id.partition(":")
    if kind == "config":
        owner = classify(name, current_generation=current_generation(base),
                         repo_dir=repo, home=base)
        return f"{name}\nowner: {owner.kind}\ntarget: {owner.target}"
    if kind == "app":
        app_dirs = [os.path.join(base, relative) for relative in DESKTOP_DIRS]
        app_dirs.append(SYSTEM_DESKTOP_DIR)
        for app in collect_desktop_entries(app_dirs, home=base):
            if app.get("name") == name:
                return (f"{name}\ndesktop file: {app.get('desktop_file', '')}"
                        f"\nsource: {app.get('source', '')}")
        return f"{name}\nnot found"
    path = shutil.which(name)
    if path is None:
        candidate = os.path.join(base, ".local", "bin", name)
        path = candidate if os.path.exists(candidate) else None
    if path is None:
        return f"{name}\nnot found on PATH"
    return f"{name}\npath: {path}"


def browse(*, home=None, repo_dir=None, runner=None, launcher=None) -> int:
    """The interactive browser over everything the machine owns."""
    base = os.path.abspath(home) if home is not None else str(Path.home())
    rows = browse_rows(home=base, repo_dir=repo_dir)
    if not rows:
        print("nothing to browse")
        return 0
    lines = [f"{row['id']}\t{row['label']}\t{row['detail']}" for row in rows]
    chosen = run_fzf(lines, runner=runner)
    if chosen is None:
        print("\n".join(f"{row['label']}  ({row['kind']})" for row in rows))
        return 0
    if not chosen:
        print("nothing was chosen")
        return 0
    by_id = {row["id"]: row for row in rows}
    run = launcher or (lambda cmd: subprocess.run(cmd, check=False))
    for item_id in chosen:
        row = by_id.get(item_id, {})
        kind, _, name = item_id.partition(":")
        try:
            if kind == "app":
                run(["gtk-launch", row.get("target") or name])
            elif kind == "config":
                editor = os.environ.get("EDITOR", "xdg-open")
                run([editor, name])
            else:
                path = shutil.which(name) or os.path.join(base, ".local", "bin", name)
                run(["wl-copy", path])
                print(path)
        except FileNotFoundError as error:
            print(f"{error.filename or 'the helper'} is not installed", file=sys.stderr)
    return 0


# ── keys ──

BIND_RE = re.compile(
    r"^\s*(?P<keys>[A-Za-z0-9_+.\-]+)"
    r"(?P<flags>(?:\s+[a-z][a-z-]*(?:=[^\s]+)?)*)"
    r"\s*\{\s*(?P<action>.*?);?\s*\}\s*$"
)

ACTION_DESCRIPTIONS = {
    "toggle-overview": ("عرض كل النوافذ", "Toggle the overview"),
    "show-hotkey-overlay": ("طبقة الاختصارات", "Show the hotkey overlay"),
    "focus-window-left": ("التركيز على النافذة يساراً", "Focus the window to the left"),
    "focus-window-right": ("التركيز على النافذة يميناً", "Focus the window to the right"),
    "focus-window-up": ("التركيز على النافذة أعلى", "Focus the window above"),
    "focus-window-down": ("التركيز على النافذة أسفل", "Focus the window below"),
    "focus-column-left": ("التركيز على العمود يساراً", "Focus the column to the left"),
    "focus-column-right": ("التركيز على العمود يميناً", "Focus the column to the right"),
    "focus-monitor-left": ("التركيز على الشاشة يساراً", "Focus the monitor to the left"),
    "focus-monitor-right": ("التركيز على الشاشة يميناً", "Focus the monitor to the right"),
    "focus-monitor-up": ("التركيز على الشاشة أعلى", "Focus the monitor above"),
    "focus-monitor-down": ("التركيز على الشاشة أسفل", "Focus the monitor below"),
    "focus-workspace-up": ("التركيز على مساحة العمل أعلى", "Focus the workspace above"),
    "focus-workspace-down": ("التركيز على مساحة العمل أسفل", "Focus the workspace below"),
    "move-window-left": ("تحريك النافذة يساراً", "Move the window to the left"),
    "move-window-right": ("تحريك النافذة يميناً", "Move the window to the right"),
    "move-window-up": ("تحريك النافذة أعلى", "Move the window above"),
    "move-window-down": ("تحريك النافذة أسفل", "Move the window below"),
    "move-column-left": ("تحريك العمود يساراً", "Move the column to the left"),
    "move-column-right": ("تحريك العمود يميناً", "Move the column to the right"),
    "move-column-up": ("تحريك العمود أعلى", "Move the column above"),
    "move-column-down": ("تحريك العمود أسفل", "Move the column below"),
    "move-workspace-up": ("تحريك مساحة العمل أعلى", "Move the workspace up"),
    "move-workspace-down": ("تحريك مساحة العمل أسفل", "Move the workspace down"),
    "toggle-window-floating": ("تبديل النافذة إلى عائمة", "Toggle the window floating"),
    "toggle-keyboard-shortcuts-inhibit": ("تجميد اختصارات لوحة المفاتيح", "Toggle the keyboard shortcut inhibit"),
    "switch-focus-between-floating-and-tiling": ("التبديل بين العائمة والمربّعة", "Switch between floating and tiling"),
    "switch-preset-window-height": ("تبديل ارتفاع النافذة", "Cycle the preset window height"),
    "switch-preset-column-width": ("تبديل عرض العمود", "Cycle the preset column width"),
    "switch-preset-column-width-back": ("تبديل عرض العمود بالعكس", "Cycle the preset column width backwards"),
    "toggle-column-tabbed-display": ("تبديل عرض العمود كتبويب", "Toggle the tabbed column display"),
    "close-window": ("إغلاق النافذة", "Close the window"),
    "quit": ("الخروج من niri", "Quit niri"),
    "screenshot": ("لقطة شاشة", "Take a screenshot"),
}


@dataclasses.dataclass(frozen=True)
class KeyBinding:
    """One key combination and what it does."""

    keys: str
    action: str
    description: str


def describe_action(action: str, *, lang: str = "ar") -> str:
    """A human description of a niri action, in Arabic or English."""
    text = action.strip()
    described = ACTION_DESCRIPTIONS.get(text)
    if described is not None:
        return described[0] if lang == "ar" else described[1]
    spawn = re.match(r'^spawn(?:-sh)?\s+"([^"]+)"', text)
    if spawn is not None:
        command = spawn.group(1)
        return f"تشغيل {command}" if lang == "ar" else f"Run {command}"
    return text


def parse_key_bindings(text: str) -> list[KeyBinding]:
    """The binds of a niri config, in file order.

    Every bind of this config is on one line. A bind whose braces do not
    close on the same line is skipped rather than guessed at.
    """
    bindings: list[KeyBinding] = []
    inside = False
    depth = 0
    for line in text.splitlines():
        stripped = line.strip()
        if not inside:
            if stripped == "binds {":
                inside = True
            continue
        if stripped == "}":
            break
        match = BIND_RE.match(line)
        if match is None:
            continue
        action = match.group("action").strip()
        bindings.append(KeyBinding(
            keys=match.group("keys"),
            action=action,
            description=describe_action(action, lang="ar"),
        ))
    return bindings


def render_key_bindings(bindings: list[KeyBinding], *, lang: str = "ar") -> str:
    """The cheat sheet table."""
    width = max((len(binding.keys) for binding in bindings), default=4)
    lines = []
    for binding in bindings:
        description = describe_action(binding.action, lang=lang)
        lines.append(f"  {binding.keys:<{width}}   {description}")
    return "\n".join(lines)


def key_bindings(*, home: str | None = None) -> list[KeyBinding]:
    """The live niri bindings."""
    base = home if home is not None else str(Path.home())
    path = os.path.join(base, NIRI_CONFIG_REL)
    try:
        with open(path, encoding="utf-8", errors="replace") as handle:
            text = handle.read()
    except OSError:
        return []
    return parse_key_bindings(text)


def keys_window_text(*, home: str | None = None, lang: str = "ar") -> str:
    """The cheat sheet, ready for a window."""
    bindings = key_bindings(home=home)
    header = "اختصارات niri" if lang == "ar" else "niri shortcuts"
    return f"{header}\n\n" + render_key_bindings(bindings, lang=lang)


def open_keys_window(text: str) -> bool:
    """Show the cheat sheet in a window; returns whether a window was opened."""
    if shutil.which("zenity"):
        subprocess.run(["zenity", "--text-info", "--title=dot keys",
                        "--width=760", "--height=640"], input=text, text=True, check=False)
        return True
    if shutil.which("yad"):
        subprocess.run(["yad", "--text", "--title=dot keys", "--width=760", "--height=640"],
                       input=text, text=True, check=False)
        return True
    return False


# ---------------------------------------------------------------------------
# The menu — the one front door the bar and the keyboard open
# ---------------------------------------------------------------------------

MENU_BACK = "Back"


@dataclasses.dataclass(frozen=True)
class MenuItem:
    """One row of the menu. The dotted id decides which submenu holds it."""

    id: str
    label: str
    icon: str
    action: str = ""
    needs: tuple[str, ...] = ()
    confirm: str = ""
    checked: bool = False
    query: str = ""


# The tree mirrors the shape of a desktop menu, not of the scripts: `dot keys`
# lives under Learn because that is where a person looks for it, even though
# it is a dot subcommand like the rest. A row with a `query` prompt asks for a
# word first; `{query}` in its action is replaced by what was typed.
MENU_ITEMS: tuple[MenuItem, ...] = (
    MenuItem("apps", "Apps", "󰀻", action="app-menu", needs=("app-menu",)),
    MenuItem("appearance", "Appearance", "󰏘"),
    MenuItem("appearance.theme", "Themes", "󰸌", needs=("set-theme",)),
    MenuItem("appearance.wallpaper", "Wallpaper", "󰸉", needs=("set-wallpaper",)),
    MenuItem("appearance.bar", "Toggle bar", "󰍜",
             action="toggle-waybar.sh", needs=("toggle-waybar.sh",)),
    MenuItem("learn", "Learn", "󰧑"),
    MenuItem("learn.keys", "Keybindings", "", action="dot keys --gui"),
    MenuItem("packages", "Packages", "󰏗"),
    MenuItem("packages.install", "Install", "󰉉"),
    MenuItem("packages.install.nix", "from nixpkgs", "󱄅",
             action="kitty --hold dot pkg add {query}", needs=("kitty", "dot"),
             query="nixpkgs package"),
    MenuItem("packages.install.yay", "from yay (repos + AUR)", "󰣇",
             action="kitty --hold yay -S --needed {query}",
             needs=("kitty", "yay"), query="package"),
    MenuItem("packages.search", "Search", "󰍉"),
    MenuItem("packages.search.nix", "nixpkgs (offline)", "󱄅",
             needs=("nix",), query="search terms"),
    MenuItem("packages.search.yay", "yay: repos + AUR", "󰍉",
             needs=("yay",), query="search terms"),
    MenuItem("packages.remove", "Remove", "󰆴"),
    MenuItem("packages.remove.nix", "from nix (declared)", "󱄅",
             action="kitty --hold dot pkg rm {query}", needs=("kitty", "dot")),
    MenuItem("packages.remove.yay", "from yay (AUR)", "󰣇",
             action="kitty --hold yay -Rns {query}", needs=("kitty", "yay")),
    MenuItem("system", "System", "󰒓"),
    MenuItem("system.lock", "Lock", "",
             action="lock-if-not-running.sh", needs=("lock-if-not-running.sh",)),
)


def _menu_parent(item_id: str) -> str:
    return item_id.rsplit(".", 1)[0] if "." in item_id else ""


def theme_menu_items(themes_dir: str) -> list[MenuItem]:
    """One row per installed theme; the live one carries the check mark.

    The list is read from disk on every open, so a theme added tomorrow needs
    no code change here.
    """
    try:
        names = sorted(os.listdir(themes_dir))
    except OSError:
        return []
    current = os.path.basename(os.path.realpath(os.path.join(themes_dir, "current")))
    items = []
    for name in names:
        if name == "current":
            # The live-theme alias, not a theme of its own.
            continue
        if os.path.isfile(os.path.join(themes_dir, name, "theme.conf")):
            items.append(MenuItem(
                id=f"appearance.theme.{name}",
                label=name,
                icon="󰸌",
                action=f"set-theme {name}",
                needs=("set-theme",),
                checked=name == current,
            ))
    return items


def menu_children(route: str, *, items=None, themes_dir: str = "", home: str = "",
                  query: str = "", runner=None) -> list[MenuItem]:
    """The rows declared directly under a route, in declaration order."""
    table = list(MENU_ITEMS if items is None else items)
    if themes_dir:
        table.extend(theme_menu_items(themes_dir))
    table.extend(provider_items(route, query=query, home=home,
                                themes_dir=themes_dir, runner=runner))
    return [item for item in table if _menu_parent(item.id) == route]


def provider_items(route: str, *, query: str = "", home: str = "",
                   themes_dir: str = "", runner=None) -> list[MenuItem]:
    """Rows that are not written in the tree: disk, pacman and yay."""
    if route == "appearance.wallpaper":
        browse = MenuItem("appearance.wallpaper.browse", "Browse with previews", "󰋩",
                          action="wallpaper-picker", needs=("wallpaper-picker",))
        return [browse] + wallpaper_menu_items(home=home, themes_dir=themes_dir)
    if route == "packages.remove.nix":
        return _remove_items("packages.remove.nix", declared_package_names(),
                             "kitty --hold dot pkg rm {name}", needs=("kitty", "dot"))
    if route == "packages.remove.yay":
        return _remove_items("packages.remove.yay",
                             removable_packages(foreign_package_names(runner=runner)),
                             "kitty --hold yay -Rns {name}", needs=("kitty", "yay"))
    if route == "packages.search.yay" and query:
        return search_menu_items(query, runner=runner)
    if route == "packages.search.nix" and query:
        return nix_search_menu_items(query, runner=runner)
    return []


WALLPAPER_SUFFIXES = (".jpg", ".jpeg", ".png", ".webp")


def wallpaper_paths(*, home: str = "", themes_dir: str = "") -> list[str]:
    """The pictures folder first, then one default per theme."""
    base = home or str(Path.home())
    found: list[str] = []
    seen: set[str] = set()

    def add(path: str) -> None:
        real = os.path.realpath(path)
        if real not in seen:
            seen.add(real)
            found.append(path)

    try:
        names = sorted(os.listdir(os.path.join(base, "Pictures")))
    except OSError:
        names = []
    for name in names:
        if name.lower().endswith(WALLPAPER_SUFFIXES):
            add(os.path.join(base, "Pictures", name))
    try:
        themes = sorted(os.listdir(themes_dir))
    except OSError:
        themes = []
    for name in themes:
        if name == "current":
            continue
        path = os.path.join(themes_dir, name, "wallpaper.jpg")
        if os.path.isfile(path):
            add(path)
    return found


def wallpaper_menu_items(*, home: str = "", themes_dir: str = "") -> list[MenuItem]:
    """Every wallpaper on disk, with a check on the one swaybg is showing."""
    base = home or str(Path.home())
    try:
        with open(os.path.join(base, ".cache", "current-wallpaper"), encoding="utf-8") as handle:
            current = os.path.realpath(handle.read().strip())
    except OSError:
        current = ""
    themes_root = os.path.realpath(themes_dir) + os.sep if themes_dir else ""
    items = []
    for index, path in enumerate(wallpaper_paths(home=base, themes_dir=themes_dir)):
        real = os.path.realpath(path)
        label = os.path.basename(path)
        if themes_root and real.startswith(themes_root):
            label = f"{os.path.basename(os.path.dirname(real))} · wallpaper"
        items.append(MenuItem(
            id=f"appearance.wallpaper.{index}",
            label=label,
            icon="󰸉",
            action=f"set-wallpaper {shlex.quote(path)}",
            needs=("set-wallpaper",),
            checked=real == current,
        ))
    return items


def declared_package_names(*, repo_dir: str = "") -> list[str]:
    """The packages this repository declares for the nix profile."""
    repo = repo_dir or default_repo_dir()
    if not repo:
        return []
    try:
        with open(os.path.join(repo, DECLARATIONS_FILE), encoding="utf-8") as handle:
            return parse_declared_packages(handle.read())
    except OSError:
        return []


def foreign_package_names(*, runner=None) -> list[str]:
    """Installed from the AUR or elsewhere — what `yay` owns and may remove.

    Repository packages are left out on purpose: half of them are the boot
    path, and pacman is the honest tool for those.
    """
    run = runner or subprocess.run
    try:
        proc = run(["pacman", "-Qmq"], capture_output=True, text=True, check=False)
    except (FileNotFoundError, OSError):
        return []
    return [line.strip() for line in proc.stdout.splitlines() if line.strip()]


# Removing any of these breaks the boot path or the desktop itself, so the
# menu never offers them even though pacman calls them explicit.
PROTECTED_PACKAGES = frozenset({
    "base", "base-devel", "pacman", "sudo", "systemd", "systemd-sysvcompat",
    "linux", "linux-firmware", "linux-headers", "grub", "mesa", "niri",
    "networkmanager", "pipewire", "wireplumber",
})


def removable_packages(names: list[str]) -> list[str]:
    return [name for name in names
            if name not in PROTECTED_PACKAGES and not name.startswith(("linux-", "nvidia-"))]


def _remove_items(route: str, names: list[str], action: str, *, needs: tuple[str, ...]) -> list[MenuItem]:
    return [MenuItem(
        id=f"{route}.{name}",
        label=name,
        icon="󰆴",
        action=action.replace("{name}", shlex.quote(name)),
        needs=needs,
    ) for name in names]


SEARCH_RESULT_RE = re.compile(r"^(?P<repo>[\w.-]+)/(?P<name>[\w@._+-]+)\s+(?P<version>\S+)")


def search_results(query: str, *, runner=None, limit: int = 30) -> list[tuple[str, str, str]]:
    """`yay -Ss` read as (repo, name, version + description) rows."""
    if not query.strip():
        return []
    run = runner or subprocess.run
    try:
        proc = run(["yay", "-Ss", query], capture_output=True, text=True, check=False)
    except (FileNotFoundError, OSError):
        return []
    lines = proc.stdout.splitlines()
    results: list[tuple[str, str, str]] = []
    for index, line in enumerate(lines):
        match = SEARCH_RESULT_RE.match(line)
        if not match:
            continue
        description = lines[index + 1].strip() if index + 1 < len(lines) else ""
        detail = f"{match.group('version')}  {description}".strip()
        results.append((match.group("repo"), match.group("name"), detail))
        if len(results) >= limit:
            break
    return results


def nixpkgs_source(*, runner=None) -> str:
    """The nixpkgs the flake pins, resolved from the store without the network."""
    repo = default_repo_dir()
    if not repo:
        return ""
    run = runner or subprocess.run
    expr = f'(builtins.getFlake "{repo}").inputs.nixpkgs.outPath'
    try:
        proc = run(["nix", "eval", "--raw", "--impure", "--offline", "--expr", expr],
                   capture_output=True, text=True, check=False)
    except (FileNotFoundError, OSError):
        return ""
    path = proc.stdout.strip()
    return path if path.startswith("/nix/store/") else ""


def nix_search(query: str, *, runner=None, limit: int = 30) -> list[str]:
    """Attribute names in the pinned nixpkgs.

    The flake registry is unreachable on this machine, so `nix search nixpkgs`
    cannot be used: the store copy of nixpkgs is evaluated directly instead.
    """
    if not query.strip():
        return []
    source = nixpkgs_source(runner=runner)
    if not source:
        return []
    run = runner or subprocess.run
    expr = ("let p = import " + source + ' { }; q = builtins.getEnv "DOT_SEARCH"; '
            "in builtins.filter (n: p.lib.hasInfix q n) (builtins.attrNames p)")
    env = dict(os.environ, DOT_SEARCH=query)
    try:
        proc = run(["nix", "eval", "--impure", "--offline", "--json", "--expr", expr],
                   capture_output=True, text=True, check=False, env=env)
        names = json.loads(proc.stdout or "[]")
    except (FileNotFoundError, OSError, ValueError):
        return []
    return sorted(name for name in names if isinstance(name, str))[:limit]


def nix_search_menu_items(query: str, *, runner=None) -> list[MenuItem]:
    """nixpkgs hits are rows that hand the name to `dot pkg add`."""
    return [MenuItem(
        id=f"packages.search.nix.{index}",
        label=name,
        icon="󱄅",
        action=f"kitty --hold dot pkg add {shlex.quote(name)}",
        needs=("kitty", "dot"),
    ) for index, name in enumerate(nix_search(query, runner=runner))]


def search_menu_items(query: str, *, runner=None) -> list[MenuItem]:
    """Search results are rows you can install straight from."""
    return [MenuItem(
        id=f"packages.search.yay.{index}",
        label=f"{name}  ·  {repo}  ·  {detail}",
        icon="󰏗",
        action=f"kitty --hold yay -S --needed {shlex.quote(name)}",
        needs=("kitty", "yay"),
    ) for index, (repo, name, detail) in enumerate(search_results(query, runner=runner))]


def _menu_available(item: MenuItem, *, which=None, home: str = "") -> bool:
    """A row that would fail must not be listed: no command, no entry."""
    look = which or shutil.which
    for name in item.needs:
        if look(name):
            continue
        if home and os.path.exists(os.path.join(home, ".local", "bin", name)):
            continue
        return False
    return True


def menu_rows(route: str, *, items=None, which=None, home: str = "",
              themes_dir: str = "", query: str = "", runner=None) -> list[MenuItem]:
    """The rows under a route that this machine can actually run."""
    rows = []
    for item in menu_children(route, items=items, themes_dir=themes_dir, home=home,
                              query=query, runner=runner):
        if not _menu_available(item, which=which, home=home):
            continue
        if menu_children(item.id, items=items, themes_dir=themes_dir, home=home,
                         runner=runner):
            # A submenu whose rows are all missing would open onto an empty
            # window, so it is not offered at all.
            if not menu_rows(item.id, items=items, which=which, home=home,
                             themes_dir=themes_dir, runner=runner):
                continue
        rows.append(item)
    return rows


def render_menu_rows(rows: list[MenuItem]) -> list[str]:
    return [f"{item.icon}  {item.label}" + ("  ✓" if item.checked else "") for item in rows]


def fuzzel_launcher(rows: list[str], prompt: str) -> str | None:
    """One fuzzel window; None means nothing was chosen or fuzzel is missing."""
    if not rows:
        return None
    cmd = ["fuzzel", "--dmenu", f"--prompt={prompt}  ",
           "--width=44", f"--lines={min(len(rows), 12)}"]
    try:
        proc = subprocess.run(cmd, input="\n".join(rows) + "\n",
                              capture_output=True, text=True, check=False)
    except (FileNotFoundError, OSError):
        return None
    return proc.stdout.strip() or None


def fuzzel_prompt(prompt: str) -> str | None:
    """A fuzzel window with nothing to pick, so the keyboard supplies the word."""
    cmd = ["fuzzel", "--dmenu", f"--prompt={prompt}:  ", "--width=44", "--lines=1"]
    try:
        proc = subprocess.run(cmd, input="", capture_output=True, text=True, check=False)
    except (FileNotFoundError, OSError):
        return None
    return proc.stdout.strip() or None


def _notify(message: str) -> None:
    if not shutil.which("notify-send"):
        return
    subprocess.run(["notify-send", "dot menu", message], check=False)


def menu_action_argv(action: str) -> list[str]:
    argv = shlex.split(action)
    if "dot" in argv:
        # waybar's on-click runs in a bare shell, and kitty execs directly:
        # never trust PATH to find us.
        argv[argv.index("dot")] = os.path.realpath(__file__)
    if argv and not os.path.isabs(argv[0]) and shutil.which(argv[0]) is None:
        local = os.path.join(str(Path.home()), ".local", "bin", argv[0])
        if os.path.exists(local):
            argv[0] = local
    return argv


def _menu_prompt(route: str, items) -> str:
    if not route:
        return "dot"
    for item in items:
        if item.id == route:
            return item.label
    return "dot"


def _menu_confirmed(item: MenuItem, choose) -> bool:
    rows = ["✕  Cancel", f"✓  Yes, {item.label}"]
    return choose(rows, f"{item.confirm}?") == rows[1]


def run_menu(*, home: str = "", themes_dir: str = "", items=None, which=None,
             launcher=None, ask=None, run=None) -> int:
    """Walk the tree with fuzzel, one window per level, and run what is chosen."""
    base = home or str(Path.home())
    themes = themes_dir or os.path.join(base, ".config", "themes")
    choose = launcher or fuzzel_launcher
    type_text = ask or fuzzel_prompt
    execute = run or (lambda argv: subprocess.run(argv, check=False))
    table = list(MENU_ITEMS if items is None else items)
    if launcher is None and not shutil.which("fuzzel"):
        # Same rule as `dot keys`: without a window, print the list.
        print(render_menu_tree(items=table, which=which, home=base, themes_dir=themes))
        return 0
    stack: list[tuple[str, list[MenuItem] | None]] = [("", None)]
    while stack:
        route, preset = stack[-1]
        rows = preset if preset is not None else menu_rows(
            route, items=table, which=which, home=base, themes_dir=themes)
        display = render_menu_rows(rows)
        back = f"←  {MENU_BACK}" if route else ""
        if back:
            display.append(back)
        chosen = choose(display, _menu_prompt(route, table))
        if chosen is None:
            return 0
        if back and chosen == back:
            stack.pop()
            continue
        item = next((row for row, shown in zip(rows, display) if shown == chosen), None)
        if item is None:
            return 0
        if item.query:
            typed = type_text(item.query)
            if not typed:
                continue
            found = menu_rows(item.id, items=table, which=which, home=base,
                              themes_dir=themes, query=typed)
            if found:
                stack.append((item.id, found))
                continue
            if "{query}" in item.action:
                execute(menu_action_argv(item.action.replace("{query}", shlex.quote(typed))))
                return 0
            _notify(f"Nothing found for “{typed}”")
            continue
        if menu_children(item.id, items=table, themes_dir=themes, home=base):
            stack.append((item.id, None))
            continue
        if item.confirm and not _menu_confirmed(item, choose):
            continue
        execute(menu_action_argv(item.action))
        return 0
    return 0


def render_menu_tree(*, items=None, which=None, home: str = "",
                     themes_dir: str = "") -> str:
    """The whole tree as text, the shape the tests pin and `--print` shows."""
    base = home or str(Path.home())
    themes = themes_dir or os.path.join(base, ".config", "themes")
    lines: list[str] = []

    def walk(route: str, depth: int) -> None:
        for item in menu_rows(route, items=items, which=which, home=base, themes_dir=themes):
            detail = item.action or (f"prompt: {item.query}" if item.query else "submenu")
            lines.append(f"{'  ' * depth}{item.id}\t{item.label}\t{detail}"
                         + ("\t✓" if item.checked else ""))
            walk(item.id, depth + 1)

    walk("", 0)
    return "\n".join(lines)


def build_inventory(*, home: str | None = None, repo_dir: str | None = None) -> Inventory:
    """Everything this machine has installed, and everything wrong with it."""
    base = os.path.abspath(home) if home is not None else str(Path.home())
    repo = repo_dir if repo_dir is not None else default_repo_dir()
    if repo and not os.path.isdir(repo):
        repo = ""

    packages = collect_pacman()
    profile_dir = os.path.join(base, PROFILE_BIN_REL)
    profile_bins = collect_profile_bins(profile_dir)
    app_dirs = [os.path.join(base, relative) for relative in DESKTOP_DIRS]
    app_dirs.append(SYSTEM_DESKTOP_DIR)
    apps = collect_desktop_entries(app_dirs, home=base)
    scripts = collect_scripts(os.path.join(base, ".local", "bin"), repo or None)
    tools = collect_tool_dirs(tool_dir_paths(base))

    entries = scan_home_configs(base, repo)

    findings = findings_from_entries(entries)
    findings.extend(_spawn_findings(os.path.join(base, NIRI_CONFIG_REL)))
    findings.extend(_nix_findings(repo, profile_dir, profile_bins))
    dirty = _repo_dirty_finding(repo)
    if dirty is not None:
        findings.append(dirty)

    cli_sources = [Source("pacman", packages["system"], "package")]
    if profile_bins:
        cli_sources.append(Source("nix", profile_bins, "cli"))
    for label, items in tools.items():
        cli_sources.append(Source(label, items, "binary"))

    meta = {
        "distro": _distro_name(),
        "host": _host_name(),
        "foreign": len(packages["foreign"]),
        "orphans": len(packages["orphans"]),
        "repo": repo,
    }
    return Inventory(
        apps=apps,
        cli=cli_sources,
        scripts=scripts,
        configs=entries,
        findings=_sort_findings(findings),
        meta=meta,
    )


def _section_lines(inventory: Inventory, section: str) -> list[str]:
    """The lines of one section of the list."""
    if section == "apps":
        lines = [f"  Desktop apps ({len(inventory.apps)}):"]
        for app in inventory.apps:
            lines.append(f"    {app.get('name', '')}  ({app.get('source', '')})")
        return lines
    if section == "cli":
        lines = []
        for source in inventory.cli:
            lines.append(f"  {source.name} ({len(source.items)}):")
            for item in source.items:
                lines.append(f"    {item}")
        return lines
    if section == "configs":
        managed = _managed_configs(inventory)
        lines = [f"  Managed configs ({len(managed)}):"]
        for entry in managed:
            lines.append(f"    {entry.path} → {entry.owner.target}  ({entry.owner.kind})")
        return lines
    if section == "scripts":
        lines = []
        for group, names in inventory.scripts.items():
            lines.append(f"  {group} scripts ({len(names)}):")
            for name in names:
                lines.append(f"    {name}")
        return lines
    if section == "sources":
        lines = ["  Sources:"]
        for source in inventory.cli:
            lines.append(f"    {source.name:<18}{len(source.items):>6}  {source.kind}")
        lines.append(f"    {'desktop entries':<18}{len(inventory.apps):>6}  app")
        for group, names in inventory.scripts.items():
            lines.append(f"    {group + ' scripts':<18}{len(names):>6}  script")
        lines.append(f"    {'config entries':<18}{len(inventory.configs):>6}  scanned")
        lines.append(f"    {'managed configs':<18}{len(_managed_configs(inventory)):>6}  owned")
        return lines
    return []


def _ownership_lines(inventory: Inventory) -> list[str]:
    """The config ownership map: every owner, its count, and where it points.

    `local:tool` links are only counted — the tool farms are noise, the
    user's own links are the point of the map.
    """
    managed = _managed_configs(inventory)
    counts: dict[str, int] = {}
    for entry in managed:
        kind = entry.owner.kind
        counts[kind] = counts.get(kind, 0) + 1
    lines = ["  Config ownership:"]
    for kind in OWNER_KINDS:
        if kind not in counts:
            continue
        lines.append(f"    {kind:<20}{counts[kind]:>6}")
    lines.append("")
    for entry in managed:
        if entry.owner.kind == OWNER_TOOL:
            continue
        lines.append(
            f"    {entry.path} → {entry.owner.target}"
            f"  ({entry.owner.kind} — {entry.owner.reason})"
        )
    return lines


def _outdated_lines(packages: list[str]) -> list[str]:
    """The packages that have a newer version waiting for them."""
    if not packages:
        return ["  Outdated: nothing"]
    lines = [f"  Outdated ({len(packages)}):"]
    for package in packages:
        lines.append(f"    {package}")
    return lines


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="dot",
        description="Inventory and health check for this machine.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_list = sub.add_parser("list", help="show what is installed")
    p_list.add_argument("--all", action="store_true", help="print every item, ungrouped")
    p_list.add_argument("--wide", action="store_true", help="do not cut the CLI list short")
    p_list.add_argument("--json", action="store_true", help="print the machine readable document")
    p_list.add_argument("--ownership", action="store_true", help="config ownership map only")
    p_list.add_argument("--outdated", action="store_true", help="also query the network for updates")
    for flag in SECTION_ORDER:
        p_list.add_argument(f"--{flag}", action="store_true", help=f"show the {flag} section only")

    p_status = sub.add_parser("status", help="show what is broken or drifted")
    p_status.add_argument("--json", action="store_true", help="print the machine readable document")

    p_health = sub.add_parser("health", help="a fast health check for the bar")
    p_health.add_argument("--json", action="store_true", help="print the waybar document")

    p_pkg = sub.add_parser("pkg", help="manage the nix packages of the profile")
    pkg_sub = p_pkg.add_subparsers(dest="pkg_command", required=True)
    pkg_sub.add_parser("list", help="show the declared packages")
    for action, help_text in (("add", "add packages"), ("rm", "remove packages")):
        parser_action = pkg_sub.add_parser(action, help=help_text)
        parser_action.add_argument("names", nargs="+", help="the package names")
        parser_action.add_argument("--yes", action="store_true", help="do not ask")
        parser_action.add_argument("--dry-run", action="store_true", help="print the change and stop")
        parser_action.add_argument("--config", default="", help="the Home Manager configuration name")
    parser_sync = pkg_sub.add_parser("sync", help="apply the repository as it stands")
    parser_sync.add_argument("--yes", action="store_true", help="do not ask")
    parser_sync.add_argument("--config", default="", help="the Home Manager configuration name")

    p_browse = sub.add_parser("browse", help="search everything the machine owns")
    p_show = sub.add_parser("show", help="the details of one item")
    p_show.add_argument("item", help="the id of the item, for example config:/home/zeyad/.config/niri")

    p_keys = sub.add_parser("keys", help="the niri shortcut cheat sheet")
    p_keys.add_argument("--lang", default="ar", choices=["ar", "en"], help="the language of the table")
    p_keys.add_argument("--gui", action="store_true", help="open it in a window")

    p_menu = sub.add_parser("menu", help="the front door: apps, themes, keys and power")
    p_menu.add_argument("--print", dest="print_tree", action="store_true",
                        help="print the menu tree and stop")

    args = parser.parse_args(argv)

    if args.command == "keys":
        bindings = key_bindings()
        if args.gui:
            text = keys_window_text(lang=args.lang)
            if not open_keys_window(text):
                print(text)
            return 0
        print(render_key_bindings(bindings, lang=args.lang))
        return 0

    if args.command == "menu":
        if args.print_tree:
            print(render_menu_tree())
        else:
            run_menu()
        return 0

    if args.command == "browse":
        return browse()

    if args.command == "show":
        print(show_item(args.item))
        return 0

    if args.command == "pkg":
        # `dot pkg` edits one file and runs one switch; it must not pay for
        # the inventory or the health scan first.
        return pkg_main(args)

    if args.command == "health":
        # The probe answers before the inventory is built: the bar calls it
        # every ten seconds and must not pay for pacman, nix and git.
        health = collect_health()
        if args.json:
            print(json.dumps(health_json(health)))
        else:
            print(render_health(health))
        return 0 if health.ok else 1

    inventory = build_inventory()

    if args.command == "list":
        if args.json:
            # The frozen document has no slot for the update check, so `--outdated`
            # stays a text mode addition and the JSON never touches the network.
            print(json.dumps(inventory_json(inventory, command="list"), indent=2))
            return 0
        lines: list[str] = []
        if args.ownership:
            lines.extend(_ownership_lines(inventory))
        elif any(getattr(args, flag) for flag in SECTION_ORDER):
            for flag in SECTION_ORDER:
                if getattr(args, flag):
                    lines.extend(_section_lines(inventory, flag))
        else:
            lines.append(render_list(inventory, show_all=args.all, wide=args.wide))
        print("\n".join(lines))
        if args.outdated:
            print("")
            print("\n".join(_outdated_lines(collect_outdated())))
        return 0

    if args.json:
        print(json.dumps(inventory_json(inventory, command="status"), indent=2))
    else:
        print(render_status(inventory))
    counts = _severity_counts(inventory.findings)
    return 1 if any(counts[key] for key in HEADLINE_SEVERITIES) else 0


if __name__ == "__main__":
    sys.exit(main())
