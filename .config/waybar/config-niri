{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 8,

  "modules-left": ["custom/launcher", "niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["niri/language", "network", "pulseaudio", "backlight", "custom/dot-health", "cpu", "memory", "battery", "custom/swaync", "tray", "custom/power"],

  "custom/launcher": {
    "format": "",
    "tooltip": false,
    "on-click": "$HOME/.local/bin/app-menu"
  },

  "niri/workspaces": {
    "format": "{index}",
    "all-outputs": true,
    "disable-click": false
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 80,
    "rewrite": {
      "(.*) - Brave": "$1",
      "(.*) - Mozilla Firefox": "$1",
      "(.*) - zsh": " $1"
    }
  },

  "niri/language": {
    "format": "{}",
    "on-click": "$HOME/.local/bin/switch-layout.sh"
  },

  "network": {
    "interval": 2,
    "format-wifi": " {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰖪 offline",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },

  "pulseaudio": {
    "scroll-step": 2,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphones": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "backlight": {
    "format": "󰃠 {percent}%",
    "on-scroll-up": "brightnessctl -c backlight set +5%",
    "on-scroll-down": "brightnessctl -c backlight set 5%-"
  },

  "clock": {
    "format": " {:%I:%M %p}",
    "format-alt": " {:%A, %d %B %Y}",
    "tooltip-format": "{:%A, %d %B %Y}"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/swaync": {
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "tooltip": false
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "sh $HOME/.local/bin/power-menu-niri.sh"
  },

  "custom/dot-health": {
    "interval": 10,
    "return-type": "json",
    "exec": "$HOME/.config/waybar/scripts/dot-health.sh",
    "on-click": "$HOME/.local/bin/dot menu",
    "tooltip": true
  },

  "custom/hijri": {
    "interval": 60,
    "exec": "$HOME/.config/waybar/scripts/hijri-clock.sh",
    "tooltip": false
  },

  "cpu": {
    "interval": 5,
    "format": "\uF2DB {usage}%",
    "tooltip": true
  },

  "memory": {
    "interval": 10,
    "format": "\uF0FC {percentage}%",
    "tooltip": true
  },

  "battery": {
    "format": "{icon} {percentage}%",
    "format-icons": ["\uF240", "\uF241", "\uF242", "\uF243"]
  }
}
